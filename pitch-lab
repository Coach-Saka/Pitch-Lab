    const velo=ag(csvVals('velo',rs).map(toMph));
    const rpm =ag(csvVals('rpm',rs));
    const ivbA=csvVals('ivb',rs).map(toInch), hbA=csvVals('hb',rs).map(v=>toInch(v)*sgn);
    const effA=csvVals('eff',rs).map(v=>v>1.5?v/100:v);
    const tiA =rs.map(r=>csvTilt(csvCol(r,'tilt'))).filter(v=>isFinite(v));
    const hA=csvVals('relh',rs).map(toM), sA=csvVals('rels',rs).map(toM), eA=csvVals('ext',rs).map(toM);
    const nm=PT_EN[normH(key)]||key;
    return {key, name:nm, n:rs.length,
      velo, rpm,
      ivb: ivbA.length?ag(ivbA):NaN,
      hb : hbA.length ?ag(hbA) :NaN,
      eff: effA.length?ag(effA):NaN,
      tilt:tiA.length ?ag(tiA) :NaN,
      relh:hA.length?ag(hA):NaN, rels:sA.length?ag(sA):NaN, ext:eA.length?ag(eA):NaN,
      sdV:sd(csvVals('velo',rs).map(toMph)), sdH:sd(hA), sdS:sd(sA),
      dh: (hA.length&&isFinite(baseH))?ag(hA)-baseH:0,
      ds: (sA.length&&isFinite(baseS))?(ag(sA)-baseS)*sgn:0,
      de: (eA.length&&isFinite(baseE))?ag(eA)-baseE:0};
  });
  out.sort((a,b)=>b.n-a.n);
  return {list:out, baseH, baseS, baseE,
          sdH:sd(allH), sdS:sd(allS), n:rows.length};
}
function csvOn(g){
  if(CSV.off[g.key]) return false;
  if($('#csvMin').checked && g.n<3) return false;
  return isFinite(g.velo)&&isFinite(g.rpm);
}
function csvSolved(g,hand){
  if(!(isFinite(g.ivb)&&isFinite(g.hb)&&isFinite(g.velo)&&isFinite(g.rpm))) return null;
  return solveSpin(g.velo,g.rpm,g.ivb,armToWorld(g.hb,hand));
}
function csvRefresh(){
  const G=csvGroups(); CSV.groups=G;
  const useMeas=CSV.map.ivb>=0&&CSV.map.hb>=0;
  let h='<thead><tr><th>Pitch type (CSV)</th><th>Import as</th><th>n</th><th>Velo<br><small>mph</small></th>'+
    '<th>Spin<br><small>rpm</small></th><th>Vert<br><small>in</small></th><th>Horz<br><small>in, arm +</small></th>'+
    '<th>Efficiency<br><small>'+(useMeas?'solved / CSV':'%')+'</small></th>'+
    '<th>Axis<br><small>'+(useMeas?'solved / CSV':'catcher view')+'</small></th>'+
    '<th>&Delta;Ht<br><small>in</small></th><th>&Delta;Side<br><small>in</small></th><th>&Delta;Ext<br><small>in</small></th>'+
    '<th>Velo<br><small>scatter</small></th><th>Status</th></tr></thead><tbody>';
  const f1=(v,d)=>isFinite(v)?v.toFixed(d===undefined?1:d):'—';
  const dClock=(a,b)=>{ let d=Math.abs(a-b)%12; return Math.min(d,12-d); };
  G.list.forEach(g=>{
    const on=csvOn(g);
    const tc=isFinite(g.tilt)?(CSV.ut==='p'?mirrorClock(g.tilt):g.tilt):NaN;
    const sv=useMeas?csvSolved(g,CSV.hand):null;
    const sub=(v,warn)=>'<small style="display:block;color:'+(warn?'var(--warn)':'#6f6e67')+'">'+v+'</small>';
    let cEff, cTil, st;
    if(sv){
      const de=isFinite(g.eff)?Math.abs(sv.effRaw-g.eff)*100:0;
      const dt=isFinite(tc)?dClock(sv.tilt,tc):0;
      cEff=(sv.effRaw*100).toFixed(0)+(isFinite(g.eff)?sub((g.eff*100).toFixed(0),de>12):'');
      cTil=clockStr(sv.tilt)+(isFinite(tc)?sub(clockStr(tc),dt>1):'');
      st=!sv.ok?'<span style="color:var(--bad)">not enough spin<small style="display:block">needs about '+sv.need+' rpm</small></span>'
        :(dt>1?'<span style="color:var(--warn)">axis and break disagree<small style="display:block">possibly seam effects</small></span>'
              :'<span style="color:var(--good)">matches the measurement</span>');
    }else{
      cEff=isFinite(g.eff)?(g.eff*100).toFixed(0):'—';
      cTil=isFinite(tc)?clockStr(tc):'—';
      st=(isFinite(g.eff)&&isFinite(tc))?'<span style="color:var(--text-muted)">computed from spin</span>'
        :'<span style="color:var(--bad)">not enough data</span>';
    }
    h+='<tr class="'+(on?'':'off')+'" data-k="'+esc(g.key)+'">'+
      '<td class="nm">'+esc(g.key)+'</td><td class="nm">'+esc(g.name)+'</td><td>'+g.n+'</td>'+
      '<td>'+f1(g.velo)+'</td><td>'+f1(g.rpm,0)+'</td>'+
      '<td>'+f1(g.ivb)+'</td><td>'+f1(g.hb)+'</td>'+
      '<td>'+cEff+'</td><td>'+cTil+'</td>'+
      '<td>'+f1(IN(g.dh),1)+'</td><td>'+f1(IN(g.ds),1)+'</td><td>'+f1(IN(g.de),1)+'</td>'+
      '<td>±'+f1(g.sdV)+'</td><td>'+st+'</td></tr>';
  });
  $('#csvPrev').innerHTML=h+'</tbody>';
  $('#csvPrev').querySelectorAll('tr[data-k]').forEach(tr=>tr.onclick=()=>{
    const k=tr.dataset.k; CSV.off[k]=!CSV.off[k]; csvRefresh();
  });
  const w=[];
  if(!useMeas) w.push('<span class="csvmiss">No vertical or horizontal break columns.</span> The import will compute break from the spin axis and efficiency instead (measured mode will be off).');
  if(CSV.map.ext<0) w.push('<span class="csvmiss">No extension column.</span> Rapsodo Pro 2.0 does not measure it, so type a tape-measured value into section 2 yourself.');
  if(CSV.map.relh<0) w.push('No release-height column, so the current release settings are kept as they are.');
  if(CSV.map.rels>=0) w.push('A device\'s Release Side is <b>measured from the centre line of the plate</b>, '+
    'so where the pitcher stood on the rubber is already baked into it. Leave "Spot on the rubber" at 0 after importing, '+
    'and move it only to ask "what if he moved over".');
  if(isFinite(G.baseH)) w.push('Mean release point: <b>'+ftS(G.baseH)+'</b> high'+
    (isFinite(G.baseS)?', <b>'+ftS(Math.abs(G.baseS))+'</b> to the side':'')+
    '&nbsp;&nbsp;scatter (1&sigma;): &plusmn;'+IN(G.sdH).toFixed(1)+'" vertical'+(isFinite(G.baseS)?', &plusmn;'+IN(G.sdS).toFixed(1)+'" horizontal':''));
  if(useMeas) w.push('Because break columns are present, <b>the spin axis and efficiency are solved backwards from the break</b> '+
    '(the table shows the solved value on top and the CSV value underneath). Where the two disagree, the pitch may be breaking more than its spin '+
    'predicts because of seam-shifted wake.');
  w.push('<b>If the pitches break the wrong way</b>, tick "Horizontal sign is inverted" above. Devices differ on which direction is positive.');
  $('#csvWarn').innerHTML=w.join('<br>');
}
function csvBuild(){
  const G=CSV.groups||csvGroups();
  const use=G.list.filter(csvOn);
  if(!use.length) return null;
  const hand=CSV.hand;
  const useMeas=CSV.map.ivb>=0&&CSV.map.hb>=0;
  const pitches=use.map((g,i)=>{
    let tilt=isFinite(g.tilt)?(CSV.ut==='p'?mirrorClock(g.tilt):g.tilt):11+10/60;
    let eff=isFinite(g.eff)?clamp(g.eff,0.02,1):0.85;
    const meas=(useMeas&&isFinite(g.ivb)&&isFinite(g.hb))?{on:true,ivb:+g.ivb.toFixed(1),hb:+g.hb.toFixed(1)}:null;
    const a=mkPitch(g.name, tilt, clamp(g.rpm,300,3600), eff, clamp(g.velo,40,110), i<4,
      meas, {dh:clamp(g.dh,-0.6,0.6), ds:clamp(g.ds,-0.6,0.6), de:clamp(g.de,-0.6,0.6)});
    applyMeas(a,hand);
    return a;
  });
  const H=isFinite(G.baseH)?clamp(G.baseH,1.20,2.25):null;
  const Sd=isFinite(G.baseS)?clamp(Math.abs(G.baseS),0,1.10):null;
  const E=isFinite(G.baseE)?clamp(G.baseE,1.40,2.45):null;
  let slot=null;
  if(H!==null&&Sd!==null){
    slot=clamp(Math.round(Math.atan2(H-1.30,Sd-0.15)*180/Math.PI),-15,95);
  }
  return {pitches, H, Sd, E, slot, hand, G,
    jit: clamp(Math.round((G.sdH+G.sdS)/2*100),0,10),
    label:(CSV.who||CSV.metaName||CSV.fname.replace(/\.[^.]+$/,''))};
}
function csvApply(mode){
  const b=csvBuild();
  if(!b){ $('#csvMsg').innerHTML='<span class="csvmiss">Nothing to import.</span>'; return; }
  saveToProfile();
  const rel={};
  if(b.slot!==null) rel.slot=b.slot;
  if(b.H!==null) rel.height=b.H;
  if(b.Sd!==null) rel.side=b.Sd;
  if(b.E!==null) rel.ext=b.E;
  rel.linkH=false; rel.linkS=false; rel.linkAxis=false;
  const note='CSV import: '+b.G.n+' pitches, '+b.pitches.length+' pitch types';
  if(mode==='new'){
    PROFILES.push(mkProfile(b.label,b.hand,rel,b.pitches,note));
    PI=PROFILES.length-1;
  }else if(mode==='replace'){
    const P=PRO();
    P.name=b.label; P.hand=b.hand; P.note=note; P.sel=0;
    Object.assign(P.release,rel);
    P.arsenal=b.pitches;
  }else{
    const P=PRO();
    b.pitches.forEach(a=>{
      if(P.arsenal.length>=10) return;
      let nm=a.name, k=2;
      while(P.arsenal.some(x=>x.name===nm)) nm=a.name+k++;
      a.name=nm; a.tun=false; P.arsenal.push(a);
    });
    P.sel=P.arsenal.length-1;
  }
  if($('#csvJit').checked){ TUN.jitter=b.jit; const sj=$('#sJit'); if(sj) sj.value=b.jit; }
  $('#proName').value=PRO().name;
  renderTabs(); renderArsenal(); renderMeas(); loadProfile();
  $('#csvMsg').innerHTML='<span class="csvhit">Imported '+b.pitches.length+' pitch types.</span>';
  $('#csvBox').open=false;
  document.querySelector('#measTable').scrollIntoView({behavior:'smooth',block:'center'});
}
