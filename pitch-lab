/* ============================================================
   section 6: where to point the arm
   ============================================================ */
const AM={one:true, mode:'ns', view:'bat', grid:false, ins:0, ty:0.80, res:null};
const AMCOL=['#3987e5','#d95926','#199e70','#c98500','#d55181','#9085e9'];
let AMV={W:620,H:620,K:0,uc:0,vc:0,pj:null};
const insX  =ins=> S.batter===-1 ? -ins : ins;   // inside+ -> world x
const xToIns=x  => S.batter===-1 ? -x   : x;
const AMC=[{y:1.00,n:'up'},{y:0.80,n:'middle'},{y:0.60,n:'down'}];
const AMW=[{ins: ZONE.x*2/3,n:'in'},{ins:0,n:'middle'},{ins:-ZONE.x*2/3,n:'away'}];
function amTunPt(path){
  for(let i=1;i<path.length;i++) if(path[i].z<=TUNNEL_M){
    const a=path[i-1],b=path[i],u=(a.z-TUNNEL_M)/((a.z-b.z)||1e-9);
    return {x:a.x+(b.x-a.x)*u, y:a.y+(b.y-a.y)*u};
  }
  return {x:path[path.length-1].x, y:path[path.length-1].y};
}
/* solve the delivery that actually reaches T, and return the no-spin point and the decision-point crossing */
function amSolve(a,T){
  const rel=releasePoint(a), sp=MPH(a.velo), Pp={tilt:a.tilt,rpm:a.rpm,eff:a.eff};
  const v=aimAt(rel,sp,T,Pp,true).v;
  const ns=fly(rel,v,Pp,false,false).end;
  const f=fly(rel,v,Pp,true,true);
  return {T, ns:{x:ns.x,y:ns.y}, tun:amTunPt(f.path), t:f.t};
}
const amTarget=()=>({x:insX(AM.ins), y:AM.ty});
function amCompute(){
  const P=PRO(); if(!P||!P.arsenal.length){ AM.res=null; return null; }
  const idx = AM.one ? [P.sel] : P.arsenal.map((a,i)=>i).slice(0,6);
  const T=amTarget(), t0=performance.now();
  const N=5, X0=-0.26, X1=0.26, Y0=0.45, Y1=1.15;
  const av=v=>v.reduce((x,y)=>x+y,0)/v.length;
  const rng=v=>Math.max.apply(null,v)-Math.min.apply(null,v);
  const list=idx.map((i,k)=>{
    const a=P.arsenal[i];
    const main=amSolve(a,T);
    let grid=null, vY=0, vX=0;
    if(AM.grid||AM.one){
      grid=[];
      for(let r=0;r<N;r++)for(let c=0;c<N;c++)
        grid.push(amSolve(a,{x:X0+(X1-X0)*c/(N-1), y:Y0+(Y1-Y0)*r/(N-1)}));
      vY=rng(grid.map(q=>(q.T.y-q.ns.y)*100));
      vX=rng(grid.map(q=>armSign(q.T.x-q.ns.x)*100));
    }
    const m=movement(a.velo,a.rpm,a.eff,a.tilt);
    return {i, name:a.name, col:AMCOL[k%AMCOL.length], main, grid, vY, vX,
      dY:(T.y-main.ns.y)*100, dX:armSign(T.x-main.ns.x)*100,
      tY:(T.y-main.tun.y)*100, tX:armSign(T.x-main.tun.x)*100,
      velo:a.velo, ivb:m.ivb, hb:armSign(m.hbCatcher), t:main.t};
  });
  AM.res={list, T, ms:performance.now()-t0};
  return AM.res;
}
/* --- projection (same camera as section 2's batter view, or straight on) --- */
function amProj(){
  if(AM.view==='flat') return {
    bat:false,
    to:p=>({u:p.x, v:-p.y}),
    from:(u,v)=>({x:u, y:-v})
  };
  // exactly the camera section 2 uses: behind the box, 4.9 ft eye height, 16" toward the batter's side
  const c={x:0.40*S.batter, y:1.50, z:-5.2}, lk={x:0, y:1.10, z:7.5};
  const F=norm3({x:lk.x-c.x, y:lk.y-c.y, z:lk.z-c.z});
  const R=norm3(cross3({x:0,y:1,z:0},F)), U=cross3(F,R);
  const K=-c.z;
  return {
    bat:true, cam:c,
    to:p=>{ const d={x:p.x-c.x, y:p.y-c.y, z:K}, cc=dot3(d,F);
            return {u:dot3(d,R)/cc, v:-dot3(d,U)/cc}; },
    from:(u,v)=>{
      const A1=R.x-u*F.x, B1=R.y-u*F.y, C1=-K*(R.z-u*F.z);
      const A2=U.x+v*F.x, B2=U.y+v*F.y, C2=-K*(U.z+v*F.z);
      const det=A1*B2-A2*B1; if(!det) return {x:0,y:0.80};
      return {x:c.x+(C1*B2-C2*B1)/det, y:c.y+(A1*C2-A2*C1)/det};
    }
  };
}
/* --- SVG (the frame auto-fits the drawn points; x and y share one scale) --- */
function amSvg(){
  const R=AM.res; if(!R) return '';
  const tun=AM.mode==='tun', T=R.T, pj=amProj();
  const src=o=>tun?o.tun:o.ns;
  // work out the frame in projected coordinates
  const uv=[];
  const add=p=>uv.push(pj.to(p));
  [[-ZX,ZY0],[ZX,ZY0],[-ZX,ZY1],[ZX,ZY1],[-0.30,0.42],[0.30,0.42],[-0.30,1.20],[0.30,1.20]]
    .forEach(q=>add({x:q[0],y:q[1]}));
  add(T);
  R.list.forEach(g=>{ add(src(g.main)); if(AM.grid&&g.grid) g.grid.forEach(o=>add(src(o))); });
  let u0=Math.min.apply(null,uv.map(q=>q.u)), u1=Math.max.apply(null,uv.map(q=>q.u));
  let v0=Math.min.apply(null,uv.map(q=>q.v)), v1=Math.max.apply(null,uv.map(q=>q.v));
  const sU=Math.max(u1-u0,1e-4), sV=Math.max(v1-v0,1e-4);
  const padU=0.19*Math.max(sU,sV*0.55), padV=0.09*sV+0.02*sU;
  u0-=padU; u1+=padU; v0-=padV; v1+=padV;
  const W=620;
  let K=Math.min(W/(u1-u0), 700/(v1-v0));
  // keep the top-most point clear of the ~96px header band by padding the top only
  for(let it=0; it<3; it++){
    const topPx=(Math.min.apply(null,uv.map(q=>q.v))-v0)*K;
    if(topPx>=96) break;
    v0-=(96-topPx)/K;
    K=Math.min(W/(u1-u0), 700/(v1-v0));
  }
  const H=Math.round((v1-v0)*K), uc=(u0+u1)/2, vc=(v0+v1)/2;
  const P=p=>{const q=pj.to(p); return {x:W/2+(q.u-uc)*K, y:H/2+(q.v-vc)*K};};
  AMV={W,H,K,uc,vc,pj};
  const f=v=>v.toFixed(1);
  const seg=(x1,y1,x2,y2,st)=>{const a=P({x:x1,y:y1}),b=P({x:x2,y:y2});
    return '<line x1="'+f(a.x)+'" y1="'+f(a.y)+'" x2="'+f(b.x)+'" y2="'+f(b.y)+'" '+st+'/>';};
  const poly=(pts,st)=>'<polygon points="'+pts.map(q=>{const a=P({x:q[0],y:q[1]});return f(a.x)+','+f(a.y);}).join(' ')+'" '+st+'/>';
  const q=[];
  q.push('<svg viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg">');
  q.push('<rect width="'+W+'" height="'+H+'" fill="#0b0f14"/>');
  // ground
  const g0=P({x:-4,y:0});
  if(g0.y>18 && g0.y<H-2){
    q.push(seg(-4,0,4,0,'stroke="#3a3a35"'));
    q.push('<text x="'+(W-12)+'" y="'+f(P({x:0,y:0}).y-5)+'" fill="#57564f" font-size="9.5" text-anchor="end">ground</text>');
  }
  // the zone, projected as a plane (slightly trapezoidal from the batter's eye)
  q.push(poly([[-ZX,ZY1],[ZX,ZY1],[ZX,ZY0],[-ZX,ZY0]],'fill="none" stroke="rgba(255,255,255,.13)" stroke-dasharray="4 4"'));
  q.push(poly([[-ZONE.x,ZONE.y1],[ZONE.x,ZONE.y1],[ZONE.x,ZONE.y0],[-ZONE.x,ZONE.y0]],
    'fill="rgba(255,255,255,.035)" stroke="rgba(255,255,255,.45)" stroke-width="2"'));
  for(let i=1;i<3;i++){
    const xx=-ZONE.x+2*ZONE.x*i/3, yy=ZONE.y0+(ZONE.y1-ZONE.y0)*i/3;
    q.push(seg(xx,ZONE.y1,xx,ZONE.y0,'stroke="rgba(255,255,255,.13)"'));
    q.push(seg(-ZONE.x,yy,ZONE.x,yy,'stroke="rgba(255,255,255,.13)"'));
  }
  const inLeft=(S.batter===-1);
  const lz=P({x:-ZONE.x,y:0.80}), rz=P({x:ZONE.x,y:0.80});
  q.push('<text x="'+f(lz.x-30)+'" y="'+f(lz.y)+'" fill="#8f8e85" font-size="11" text-anchor="middle">'+(inLeft?'inside':'outside')+'</text>');
  q.push('<text x="'+f(rz.x+30)+'" y="'+f(rz.y)+'" fill="#8f8e85" font-size="11" text-anchor="middle">'+(inLeft?'outside':'inside')+'</text>');
  // height ticks along the left edge of the zone
  [[ZONE.y1,IN(ZONE.y1).toFixed(0)+'"'],[ZONE.y0,IN(ZONE.y0).toFixed(0)+'"']].forEach(t=>{
    const a=P({x:-ZONE.x,y:t[0]});
    q.push('<text x="'+f(a.x-8)+'" y="'+f(a.y+3.5)+'" fill="#6f6e67" font-size="9.5" text-anchor="end">'+t[1]+'</text>');
  });
  // lattice (optional)
  if(AM.grid) R.list.forEach(g=>{ (g.grid||[]).forEach(o=>{
    const s0=P(src(o)), t0=P(o.T);
    q.push('<line x1="'+f(s0.x)+'" y1="'+f(s0.y)+'" x2="'+f(t0.x)+'" y2="'+f(t0.y)+'" stroke="'+g.col+'" stroke-opacity="0.16" stroke-width="1"/>');
    q.push('<circle cx="'+f(s0.x)+'" cy="'+f(s0.y)+'" r="3" fill="none" stroke="'+g.col+'" stroke-opacity="0.34"/>');
    q.push('<circle cx="'+f(t0.x)+'" cy="'+f(t0.y)+'" r="2.6" fill="#ffffff" fill-opacity="0.22"/>');
  });});
  // crosshair (lines on the plate plane, projected)
  q.push(seg(T.x,-0.6,T.x,2.6,'stroke="rgba(255,255,255,.09)" stroke-dasharray="3 5"'));
  q.push(seg(-2.2,T.y,2.2,T.y,'stroke="rgba(255,255,255,.09)" stroke-dasharray="3 5"'));
  const tp=P(T), tx=tp.x, ty=tp.y;
  // each pitch: aim point -> target
  R.list.forEach(g=>{
    const s0=P(src(g.main)), a0=s0.x, b0=s0.y;
    const ang=Math.atan2(ty-b0,tx-a0), L=13, sp=0.42;
    const bx=a0+Math.cos(ang)*13, by=b0+Math.sin(ang)*13;
    const ax=tx-Math.cos(ang)*12, ay=ty-Math.sin(ang)*12;
    if(Math.hypot(tx-a0,ty-b0)>30){
      q.push('<line x1="'+f(bx)+'" y1="'+f(by)+'" x2="'+f(ax)+'" y2="'+f(ay)+
        '" stroke="'+g.col+'" stroke-opacity="0.9" stroke-width="2.4"/>');
      q.push('<polygon points="'+[[ax,ay],[ax-L*Math.cos(ang-sp),ay-L*Math.sin(ang-sp)],[ax-L*Math.cos(ang+sp),ay-L*Math.sin(ang+sp)]]
        .map(v=>f(v[0])+','+f(v[1])).join(' ')+'" fill="'+g.col+'" fill-opacity="0.9"/>');
    }
    q.push('<circle cx="'+f(a0)+'" cy="'+f(b0)+'" r="11" fill="#0b0f14" fill-opacity="0.92" stroke="'+g.col+
      '" stroke-width="2.4" stroke-dasharray="4 2.6"/>');
    const right=(a0<W*0.66);
    q.push('<text x="'+f(a0+(right?17:-17))+'" y="'+f(b0+4)+'" fill="'+g.col+
      '" font-size="12.5" font-weight="600" text-anchor="'+(right?'start':'end')+'">'+esc(g.name)+'</text>');
  });
  // the target
  q.push('<circle cx="'+f(tx)+'" cy="'+f(ty)+'" r="15" fill="none" stroke="#ffffff" stroke-opacity="0.30"/>');
  q.push('<circle cx="'+f(tx)+'" cy="'+f(ty)+'" r="7.5" fill="#ffffff" stroke="#0b0f14" stroke-width="2"/>');
  // header
  q.push('<rect x="6" y="6" width="'+(W-12)+'" height="59" rx="7" fill="#0b0f14" fill-opacity="0.84"/>');
  q.push('<text x="14" y="22" fill="#c3c2b7" font-size="11.5">'+
    (tun?'\u25cb where it passes at the decision point (23.8 ft)':'\u25cb where to point the arm (a spinless ball lands here)')+
    '&nbsp;&#8594;&nbsp;<tspan fill="#ffffff">\u25cf where you want it to finish</tspan></text>');
  q.push('<text x="14" y="39" fill="#ffffff" font-size="12">Target course: '+locName(T)+
    ' ('+inS(T.y)+' high)</text>');
  q.push('<text x="14" y="56" fill="#8f8e85" font-size="10.5">'+
    (pj.bat?(S.batter===-1?'RHB':'LHB')+"'s eye (from the box toward the pitcher, 4.9 ft eye height) \u2014 same camera as section 2"
           :'straight on from directly behind the catcher, no perspective')+'</text>');
  q.push('</svg>');
  return q.join('');
}
