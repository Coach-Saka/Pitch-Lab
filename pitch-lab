  }
  return path[path.length-1].t;
}
function drawZone3(){
  const q=(x,y)=>pr({x,y,z:0});
  const c=[q(-ZONE.x,ZONE.y1),q(ZONE.x,ZONE.y1),q(ZONE.x,ZONE.y0),q(-ZONE.x,ZONE.y0)];
  if(c.some(p=>!p))return;
