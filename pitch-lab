let cmpMode='slot';
function renderCmpTable(){
  const save={slot:S.slot,height:S.height,side:S.side,tilt:S.tilt,aimX:S.aimX,aimY:S.aimY,linkH:S.linkH,rub:S.rub};
  let h;
