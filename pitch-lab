function runAnalysis(){
  const P=PRO(), ar=P.arsenal;
  if(ar.length<2){ $('#plans').innerHTML='<div class="warnrow">You need at least two pitches in the arsenal.</div>'; return; }
  $('#anaMsg').textContent='working...';
  if(!$('#plans')) return;
  const t0=performance.now();
  const rels=ar.map(a=>releasePoint(a));
  // grid centre = the mean decision point when every pitch is thrown middle-middle
  const cen=[];
  ar.forEach((a,i)=>{
    const Pp={tilt:a.tilt,rpm:a.rpm,eff:a.eff};
    const v=aimAt(rels[i],MPH(a.velo),{x:0,y:0.80},Pp,true).v;
    cen.push(flyStop(rels[i],v,Pp,TUNNEL_M));
  });
  const cx=cen.reduce((s,q)=>s+q.x,0)/cen.length, cy=cen.reduce((s,q)=>s+q.y,0)/cen.length;
  const N=15, RX=0.46, RY=0.52;
  // each pitch x each tunnel point -> arrival point and release angle
  const grid=[];
  for(let i=0;i<N;i++)for(let j=0;j<N;j++){
    const T={x:cx-RX+2*RX*i/(N-1), y:cy-RY+2*RY*j/(N-1)};
    const cell={T, p:[]};
    for(let k=0;k<ar.length;k++){
      const a=ar[k], Pp={tilt:a.tilt,rpm:a.rpm,eff:a.eff}, sp=MPH(a.velo), rk=rels[k];
      const v0=aimAtPlane(rk,sp,T,Pp,TUNNEL_M);
      const f=fly(rk,v0,Pp,true,false);
      const el=Math.asin(clamp(v0.y/sp,-1,1))*180/Math.PI;
      const az=Math.atan2(v0.x,-v0.z)*180/Math.PI;
      const ns=fly(rk,v0,Pp,false,false).end;           // no-spin arrival = the 'aim' from section 2
      cell.p.push({k, end:f.end, el, az, aim:{x:ns.x,y:ns.y}, t:f.t});
    }
    grid.push(cell);
  }
  // brute-force scoring
  const sc=SCEN.find(x=>x.id===scenId);
  const out=[];
  grid.forEach(cell=>{
    for(let a=0;a<ar.length;a++)for(let b=0;b<ar.length;b++){
      if(a===b) continue;
      const A=cell.p[a], B=cell.p[b];
      const sep=Math.hypot(A.end.x-B.end.x, A.end.y-B.end.y);
      const dAng=Math.hypot(A.el-B.el, A.az-B.az);
      const v=sc.score(A.end,B.end,sep,dAng);
      if(v>0.03) out.push({v, a, b, T:cell.T, A, B, sep, dAng});
    }
  });
  out.sort((x,y)=>y.v-x.v);
  // keep only the best entry per pair, and thin out tunnel points that sit close together
  const picked=[];
  for(const o of out){
    if(picked.some(q=>q.a===o.a&&q.b===o.b&&Math.hypot(q.T.x-o.T.x,q.T.y-o.T.y)<0.16)) continue;
    picked.push(o);
    if(picked.length>=8) break;
  }
  PLANS=picked;
  $('#anaMsg').textContent=grid.length*ar.length+' combinations in '+(performance.now()-t0).toFixed(0)+' ms';
  renderPlans();
}
