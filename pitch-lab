        '<td>'+r.haa.toFixed(2)+'°</td><td>'+r.vaa.toFixed(2)+'°</td>'+
        '<td>'+cross.toFixed(0)+'"</td><td>'+(r.act.t*1000).toFixed(0)+'ms</td></tr>';
    }
  }else if(cmpMode==='slot'){
    $('#cmpNote').innerHTML='Same pitch, same aim, only the arm slot changes. '+
      'Turn on <b>Derive the spin axis from the arm slot too</b> and the axis follows the slot, which is closer to a real pitcher '+
      '(and then dropping the arm kills the vertical break, so VAA actually gets steeper).';
    h='<thead><tr><th>Slot</th><th>Rel ht</th><th>Axis</th><th>Arrives horz</th><th>Arrives ht</th><th>VAA</th><th>Call</th></tr></thead><tbody>';
    for(const sl of [85,70,60,45,30,15,0]){
      S.slot=sl;
