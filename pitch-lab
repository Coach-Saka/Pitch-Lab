function compute(){
  const P={tilt:S.tilt,rpm:S.rpm,eff:S.eff};
  const rel=releasePoint(CURP()), sp=MPH(S.velo), target={x:S.aimX,y:S.aimY};
  const a=aimAt(rel,sp,target,P,false);
  const noSpin=fly(rel,a.v,P,false,true);
  const act=fly(rel,a.v,P,true,true);
  const vaa=Math.atan2(act.vel.y,Math.hypot(act.vel.x,act.vel.z))*180/Math.PI;
  const haa=Math.atan2(act.vel.x,-act.vel.z)*180/Math.PI;
  const strike=Math.abs(act.end.x)<=ZONE.x+RAD && act.end.y>=ZONE.y0-RAD && act.end.y<=ZONE.y1+RAD;
  RES={rel,P,target,noSpin,act,vaa,haa,strike,v0:a.v,
       pVelo:S.velo*16.46/(RUBBER-S.ext),
       dxArm:armSign(act.end.x-target.x), dy:act.end.y-target.y,
       endArm:armSign(act.end.x), aimArm:armSign(target.x),
       endV:MS2MPH(Math.hypot(act.vel.x,act.vel.y,act.vel.z))};
  return RES;
}
function relReasons(){
  const R=RES,out=[];
  out.push(['Aimed '+Math.abs(IN(R.aimArm)).toFixed(0)+'" to the '+(R.aimArm>=0?'arm side':'glove side')+' at a height of '+
    inS(R.target.y)+'. It actually lands <b>'+Math.abs(IN(R.dxArm)).toFixed(0)+'" to the '+(R.dxArm>=0?'arm side':'glove side')+
    ' and '+Math.abs(IN(R.dy)).toFixed(0)+'" '+(R.dy>=0?'higher':'lower')+'</b>.',false]);
  const ideal=S.hand===1?slotTilt(S.slot):mirrorClock(slotTilt(S.slot));
  const gap=Math.abs(((S.tilt-ideal+18)%12)-6);
  if(gap>1.2) out.push(['A '+S.slot+'&deg; arm slot would naturally produce <b>'+clockStr(ideal)+'</b>, but the axis is set to <b>'+
    clockStr(S.tilt)+'</b>. The '+(gap*30).toFixed(0)+'&deg; gap means the axis is coming from <b>the grip and the fingers</b>, not the arm action. That is normal for a breaking ball (fastballs track the slot closely).',false]);
  else out.push(['A spin axis of '+clockStr(S.tilt)+' is close to what a '+S.slot+'&deg; arm slot ('+slotName(S.slot)+') gives on its own.',false]);
  if(R.vaa>-4.2) out.push(['VAA <b>'+R.vaa.toFixed(1)+'&deg;</b> &mdash; a very flat approach. This is the shape you want for whiffs up in the zone.',false]);
  else if(R.vaa<-7) out.push(['VAA <b>'+R.vaa.toFixed(1)+'&deg;</b> &mdash; a steep approach that stabs in from above. The shape for burying it down.',false]);
  else out.push(['VAA <b>'+R.vaa.toFixed(1)+'&deg;</b> &mdash; a standard approach angle.',false]);
  const dP=R.pVelo-S.velo;
  if(Math.abs(dP)>0.6) out.push(['Extension '+ftS(S.ext)+' is '+Math.abs(FT(S.ext-1.98)).toFixed(2)+' ft '+
    (S.ext>1.98?'in front of':'behind')+' league average (about 6.50 ft). Perceived velocity gains <b>'+(dP>0?'+':'')+dP.toFixed(1)+' mph</b>.',false]);
  if(Math.abs(S.rub)>0.02){
    const relx=-S.side*S.hand+S.rub;
    out.push(['Standing '+Math.abs(IN(S.rub)).toFixed(0)+'" to the '+(S.rub<0?'third-base':'first-base')+
      ' side of the rubber. The release point moves with you, putting it <b>'+
      Math.abs(IN(relx)).toFixed(0)+'" to the '+(relx<0?'third-base':'first-base')+' side</b> of the centre line. '+
      '<b>The break does not change</b>, but the horizontal approach angle (HAA <b>'+R.haa.toFixed(2)+'&deg;</b>) and '+
      'the angle the batter sees do.',false]);
  }
  if(!R.strike){
    const off=[];
    if(Math.abs(R.act.end.x)>ZONE.x+RAD) off.push(inS(Math.abs(R.act.end.x)-ZONE.x-RAD)+' wide');
    if(R.act.end.y>ZONE.y1+RAD) off.push(inS(R.act.end.y-ZONE.y1-RAD)+' above');
    if(R.act.end.y<ZONE.y0-RAD) off.push(inS(ZONE.y0-RAD-R.act.end.y)+' below');
    out.push(['It misses the zone by '+off.join(' and ')+'. Press "Land it middle-middle" to see where this pitch has to be aimed to finish down the pipe.',true]);
  }
  return out;
}
