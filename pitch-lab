    --good:#199e70; --warn:#c98500; --bad:#e66767;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{background:var(--surface-0);color:var(--text-primary);
    font-family:"Hiragino Kaku Gothic ProN","Yu Gothic","Noto Sans JP","Segoe UI",system-ui,sans-serif;
    font-size:14px;line-height:1.65;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1380px;margin:0 auto;padding:16px 16px 70px}
  h1{font-size:19px;margin:0 0 3px}
  .sub{color:var(--text-muted);font-size:12.5px}
  header{margin-bottom:12px}
  .card{background:var(--surface-1);border:1px solid var(--line);border-radius:10px;padding:14px}
  .card h2{font-size:12.5px;margin:0 0 10px;color:var(--text-secondary);font-weight:600;letter-spacing:.06em}
  .sect{margin-top:18px}
  .secthd{display:flex;align-items:baseline;gap:10px;margin:0 0 10px;flex-wrap:wrap}
  .secthd .n{background:var(--accent);color:#fff;font-weight:700;font-size:12px;
    width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .secthd h2{font-size:15px;margin:0;color:var(--text-primary);letter-spacing:0}
  .secthd .d{color:var(--text-muted);font-size:12px}

  /* sticky summary */
  .bar{position:sticky;top:0;z-index:20;background:rgba(17,17,16,.94);backdrop-filter:blur(8px);
    border:1px solid var(--line);border-radius:10px;padding:9px 12px;display:flex;gap:14px;
    align-items:center;flex-wrap:wrap;margin-bottom:4px}
  .bar .item{display:flex;flex-direction:column;line-height:1.25;min-width:0}
  .bar .item .v{font-size:15px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
  .bar .item .l{font-size:10px;color:var(--text-muted);white-space:nowrap}
  .bar .sep{width:1px;height:26px;background:var(--line);flex:0 0 auto}
  .bar .grow{margin-left:auto}
  .bar .ok{color:var(--good)} .bar .ng{color:var(--bad)} .bar .ac{color:var(--accent)}

  .ctl{margin-top:11px}
  .ctlrow{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:0 0 3px}
  .ctlrow label{color:var(--text-secondary);font-size:12px}
  .ctlrow output{font-variant-numeric:tabular-nums;font-size:12.5px;color:var(--text-primary);font-weight:600}
  .ctlrow output small{color:var(--text-muted);font-weight:400;font-size:10.5px;margin-left:4px}
  input[type=range]{width:100%;accent-color:var(--accent);margin:0}
  input[type=checkbox]{accent-color:var(--accent)}
  select{background:var(--surface-2);color:var(--text-primary);border:1px solid var(--line);
    border-radius:6px;padding:5px 7px;font:inherit;font-size:12.5px;width:100%}
  .chk{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;
    color:var(--text-secondary);font-size:12px}
  .seg{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden}
  .seg button{flex:1;background:transparent;border:none;color:var(--text-muted);font:inherit;
    font-size:12px;padding:5px 6px;cursor:pointer;white-space:nowrap}
  .seg button[aria-pressed=true]{background:var(--accent-soft);color:var(--text-primary)}
  button.primary{background:var(--accent);border:none;color:#fff;font:inherit;font-weight:600;
    padding:8px 14px;border-radius:8px;cursor:pointer;font-size:13px}
  button.primary:hover{background:#4d95ea}
  button.ghost{background:transparent;border:1px solid var(--line);color:var(--text-secondary);
    font:inherit;padding:7px 11px;border-radius:8px;cursor:pointer;font-size:12.5px}
  button.ghost:hover{background:var(--surface-2);color:var(--text-primary)}
  .btnrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center}
  hr{border:none;border-top:1px solid var(--line);margin:14px 0}

  canvas{display:block;width:100%;height:auto;border-radius:8px;background:#0b0f14}
  canvas#ball{background:radial-gradient(circle at 50% 44%, #16202a 0%, #0a0d11 72%)}
  .dialwrap{display:flex;gap:14px;align-items:center}
  .dial{position:relative;width:126px;height:126px;flex:0 0 126px;touch-action:none;cursor:grab;background:none!important}
  .dial:active{cursor:grabbing}
  .big{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.15}

  .g2{display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);gap:16px;align-items:start}
  @media(max-width:960px){.g2{grid-template-columns:minmax(0,1fr)}}
  .g2c{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,430px);gap:16px;align-items:start}
  .amtop{display:grid;grid-template-columns:minmax(0,250px) minmax(0,1fr);gap:14px;align-items:start}
  @media(max-width:640px){.amtop{grid-template-columns:minmax(0,1fr)}}
  .amgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;max-width:250px}
  .amgrid button{padding:6px 4px;font-size:11px;background:var(--surface-2);color:var(--text-secondary);
    border:1px solid var(--line);border-radius:6px;cursor:pointer;white-space:nowrap}
  .amgrid button:hover{border-color:#4c4c45;color:var(--text-primary)}
  .amgrid button[aria-pressed=true]{background:var(--accent-soft);border-color:var(--accent);color:var(--text-primary)}
  .rubbar{position:relative;height:11px;margin:5px 0 2px;border-radius:3px;
    background:linear-gradient(90deg,#232320 0%,#232320 6.4%,#d9d9d2 6.4%,#d9d9d2 93.6%,#232320 93.6%,#232320 100%)}
  .rubends{display:flex;justify-content:space-between;font-size:9.5px;color:#6f6e67;margin-bottom:2px}
  .rubbar i{position:absolute;top:-3px;width:9px;height:17px;border-radius:3px;
    background:var(--accent);border:1.5px solid #0b0f14;transform:translateX(-50%)}
  .savetag{font-size:11px;color:var(--text-muted);white-space:nowrap;display:flex;align-items:center;gap:5px}
  .savetag i{width:7px;height:7px;border-radius:50%;background:var(--good);flex:0 0 auto}
  .savetag.off i{background:var(--warn)}
  .savetag.off{color:var(--warn)}
  .lbchk{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--text-muted);cursor:pointer}
  #aimMap{cursor:crosshair}
  table.tbl tr.amcur td{background:var(--accent-soft);color:var(--text-primary)}
  @media(max-width:1100px){.g2c{grid-template-columns:minmax(0,1fr)}}
  #aimMap svg{width:100%;height:auto;display:block;border-radius:8px;background:#0b0f14}
  .amrule{background:var(--surface-2);border:1px solid var(--line);border-radius:9px;
    padding:9px 11px;margin-bottom:8px}
  .amrule .hd{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;
    color:var(--text-primary);margin-bottom:5px}
  .amrule .dot{width:11px;height:11px;border-radius:3px;flex:0 0 auto}
  .amrule .big{font-size:13px;color:var(--text-primary);line-height:1.55}
  .amrule .big b{color:var(--accent);font-size:15px;font-variant-numeric:tabular-nums}
  .amrule .sm{font-size:11px;color:var(--text-muted);margin-top:4px;line-height:1.5}
  .g2b{display:grid;grid-template-columns:minmax(0,330px) minmax(0,1fr);gap:16px;align-items:start}
  @media(max-width:960px){.g2b{grid-template-columns:minmax(0,1fr)}}
  .views{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:12px}
  @media(max-width:700px){.views{grid-template-columns:minmax(0,1fr)}}
  .viewttl{font-size:11.5px;color:var(--text-muted);margin:0 0 5px}
  .cols2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;align-items:start}
  @media(max-width:960px){.cols2{grid-template-columns:minmax(0,1fr)}}

  .verdict{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap}
  .vname{font-size:26px;font-weight:700;line-height:1.1}
  .vcode{color:var(--text-muted);font-size:12px;font-variant-numeric:tabular-nums}
  .vpct{margin-left:auto;font-size:24px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
  .ranks{display:flex;flex-direction:column;gap:5px;margin-top:12px}
  .rank{display:grid;grid-template-columns:96px minmax(0,1fr) 46px;gap:9px;align-items:center;font-size:12px}
  .rank .nm{color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rank.top .nm{color:var(--text-primary);font-weight:600}
  .rank .track{background:var(--surface-2);border-radius:4px;height:12px;position:relative;overflow:hidden}
  .rank .fill{position:absolute;left:0;top:0;bottom:0;background:#2f5a86;border-radius:0 4px 4px 0;transition:width .25s}
  .rank.top .fill{background:var(--accent)}
  .rank .val{text-align:right;font-variant-numeric:tabular-nums;color:var(--text-primary)}
  .why{display:flex;flex-direction:column;gap:7px;margin-top:12px}
  .why div{background:var(--surface-2);border-left:2px solid var(--accent);border-radius:0 6px 6px 0;
    padding:7px 10px;font-size:12.5px;color:var(--text-secondary)}
  .why div.w{border-left-color:var(--warn)}
  .why b{color:var(--text-primary);font-weight:600}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:8px}
  .kpi{background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:8px 10px}
  .kpi .v{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .kpi .l{font-size:10.5px;color:var(--text-muted)}
  .kpi.hit .v{color:var(--good);font-size:16px} .kpi.miss .v{color:var(--bad);font-size:16px}
  .note{color:var(--text-muted);font-size:11.5px;margin-top:10px;line-height:1.6}
  .note b{color:var(--text-secondary);font-weight:600}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--text-muted);margin-top:7px}
  .legend span{display:flex;align-items:center;gap:5px}
  .sw{width:14px;height:2.5px;display:inline-block;border-radius:2px}
  svg.chart{width:100%;height:auto;display:block}
  table.tbl{width:100%;border-collapse:collapse;font-size:12px;font-variant-numeric:tabular-nums}
  table.tbl th{color:var(--text-muted);font-weight:500;text-align:right;padding:5px 6px;
    border-bottom:1px solid var(--line);white-space:nowrap}
  table.tbl th:first-child,table.tbl td:first-child{text-align:left}
  table.tbl td{padding:6px;border-bottom:1px solid #262622;color:var(--text-secondary);text-align:right;white-space:nowrap}
  table.tbl tr{cursor:pointer}
  table.tbl tr:hover td{background:var(--surface-2);color:var(--text-primary)}
  table.tbl tr.cur td{background:var(--accent-soft);color:var(--text-primary)}
  table.tbl td.nm{color:var(--text-primary)}
  details{margin-top:16px;background:var(--surface-1);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
  details summary{cursor:pointer;color:var(--text-primary);font-size:13px;font-weight:600}
  details .body{color:var(--text-secondary);font-size:12.5px;margin-top:10px}
  details h3{font-size:12.5px;color:var(--text-primary);margin:14px 0 4px}
  details code{background:var(--surface-2);padding:1px 5px;border-radius:4px;font-size:11.5px}
  a{color:var(--accent)}
  /* ---- pitcher tabs / arsenal ---- */
  .ptabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
  .ptab{display:flex;align-items:center;gap:7px;background:var(--surface-1);border:1px solid var(--line);
    border-radius:9px 9px 0 0;padding:7px 13px;cursor:pointer;font-size:12.5px;color:var(--text-secondary);
    border-bottom-color:transparent}
  .ptab:hover{background:var(--surface-2);color:var(--text-primary)}
  .ptab.sel{background:var(--surface-2);border-color:var(--accent);color:var(--text-primary);font-weight:600}
  .ptab .hd{font-size:10px;padding:1px 5px;border-radius:4px;background:var(--surface-3);color:var(--text-muted)}
  .ptab.sel .hd{background:var(--accent-soft);color:var(--accent)}
  .toolbar{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
  .toolbar input[type=text]{background:var(--surface-2);color:var(--text-primary);border:1px solid var(--line);
    border-radius:7px;padding:6px 9px;font:inherit;font-size:12.5px;min-width:160px}
  .chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:7px}
  .chip{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;
    background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:7px 9px;cursor:pointer}
  .chip:hover{border-color:#4c4c45}
  .chip.sel{border-color:var(--accent);background:var(--accent-soft)}
  .chip .cdot{width:11px;height:11px;border-radius:3px;flex:0 0 auto;background:#4a4a43}
  .chip .cn{font-size:12.5px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .chip .cm{font-size:10.5px;color:var(--text-muted);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .chip .ck{display:flex;align-items:center;gap:3px;font-size:10.5px;color:var(--text-muted);cursor:pointer}
  .arshd{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:9px}
  .arshd h2{margin:0}
  /* ---- tunnel ---- */
  .slots{display:flex;flex-direction:column;gap:6px}
  .slot{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:center;
    background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:7px 9px;cursor:pointer}
  .slot.sel{border-color:var(--accent);background:var(--accent-soft)}
  .slot.off{opacity:.42}
  .slot .chip{width:12px;height:12px;border-radius:3px;flex:0 0 auto}
  .slot .nm{font-size:12.5px;color:var(--text-primary);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .slot .meta{font-size:10.5px;color:var(--text-muted);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .slot .tog{background:transparent;border:1px solid var(--line);color:var(--text-muted);
    border-radius:5px;font:inherit;font-size:10.5px;padding:2px 6px;cursor:pointer}
  .slot.on .tog{border-color:var(--accent);color:var(--accent)}
  .marks{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  details.csv{background:var(--surface-1);border:1px solid var(--line);border-radius:10px;
    padding:0;margin-bottom:10px;overflow:hidden}
  details.csv>summary{cursor:pointer;padding:12px 15px;font-size:13.5px;font-weight:600;
    color:var(--text-primary);list-style:none;display:flex;align-items:center;gap:8px}
  details.csv>summary::-webkit-details-marker{display:none}
  details.csv>summary::before{content:'▶';font-size:9px;color:var(--text-muted);transition:transform .15s}
  details.csv[open]>summary::before{transform:rotate(90deg)}
  details.csv>summary span.hint{font-weight:400;font-size:11.5px;color:var(--text-muted)}
  .csvbody{padding:0 15px 14px}
  .csvgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px 10px;margin:8px 0}
  .csvgrid label{display:block;font-size:11px;color:var(--text-muted)}
  .csvgrid label b{display:block;color:var(--text-secondary);font-weight:500;margin-bottom:3px;font-size:11.5px}
  .csvgrid select{width:100%}
  .csvrow{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:9px 0}
  .csvrow .lb{font-size:11.5px;color:var(--text-muted)}
  .csvhit{color:var(--good)} .csvmiss{color:var(--warn)}
  table.csvp{width:100%;border-collapse:collapse;font-size:11.5px;font-variant-numeric:tabular-nums}
  table.csvp th{color:var(--text-muted);font-weight:500;text-align:right;padding:5px 6px;
    border-bottom:1px solid var(--line);white-space:nowrap}
  table.csvp th:first-child,table.csvp td:first-child{text-align:left}
  table.csvp td{padding:5px 6px;border-bottom:1px solid #262622;color:var(--text-secondary);
    text-align:right;white-space:nowrap}
  table.csvp td.nm{color:var(--text-primary)}
  table.csvp tr.off td{opacity:.38}
  table.meas td{padding:4px 5px;white-space:nowrap}
  table.meas tr{cursor:default}
  table.meas tr:hover td{background:transparent;color:var(--text-secondary)}
  table.meas tr.cur td{background:var(--accent-soft)}
  table.meas th small{display:block;font-size:9.5px;color:#6f6e67;font-weight:400}
  table.meas input.mi{width:62px;background:var(--surface-2);color:var(--text-primary);
    border:1px solid var(--line);border-radius:6px;padding:4px 6px;font:inherit;font-size:11.5px;
    text-align:right;font-variant-numeric:tabular-nums}
  table.meas input.nmi{width:118px;text-align:left}
  table.meas input.ro{background:transparent;border-color:transparent;color:var(--text-muted)}
  table.meas input[type=checkbox]{width:auto}
  .mtag{font-size:9px;background:var(--accent-soft);color:var(--accent);border-radius:4px;
    padding:1px 4px;margin-left:3px;vertical-align:1px;font-weight:600}
  table.pair{width:100%;border-collapse:collapse;font-size:11.5px;font-variant-numeric:tabular-nums}
  table.pair th{color:var(--text-muted);font-weight:500;text-align:right;padding:5px 5px;border-bottom:1px solid var(--line);white-space:nowrap}
  table.pair th:first-child,table.pair td:first-child{text-align:left}
  table.pair td{padding:6px 5px;border-bottom:1px solid #262622;color:var(--text-secondary);text-align:right;white-space:nowrap}
  table.pair td.nm{color:var(--text-primary)}
  .tundot{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:-1px}
  /* ---- tunnel search ---- */
  .scen{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px}
  .scenb{background:var(--surface-2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;
    cursor:pointer;text-align:left;font:inherit;color:var(--text-secondary)}
  .scenb:hover{border-color:#4c4c45;color:var(--text-primary)}
  .scenb[aria-pressed=true]{border-color:var(--accent);background:var(--accent-soft);color:var(--text-primary)}
  .scenb b{display:block;font-size:12.5px;color:var(--text-primary);font-weight:600;margin-bottom:2px}
  .scenb span{font-size:10.5px;color:var(--text-muted);line-height:1.45;display:block}
  .plans{display:grid;grid-template-columns:repeat(auto-fill,minmax(322px,1fr));gap:10px;margin-top:12px}
  .plan{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:11px 12px;
    display:grid;grid-template-columns:auto 1fr;gap:11px;cursor:pointer}
  .plan:hover{border-color:var(--accent)}
  .plan .zn{flex:0 0 auto}
  .plan .ttl{font-size:12.5px;font-weight:600;color:var(--text-primary);line-height:1.4}
  .plan .sub2{font-size:10.5px;color:var(--text-muted);line-height:1.55;margin-top:3px;font-variant-numeric:tabular-nums}
  .plan .sub2 b{color:var(--text-secondary);font-weight:600}
  .plan .pbar{height:6px;background:var(--surface-3);border-radius:3px;overflow:hidden;margin-top:8px;
    border:1px solid var(--line)}
  .plan .pbar i{display:block;height:100%;background:var(--accent);border-radius:0 3px 3px 0}
  .plan .rk{font-size:10px;color:var(--text-muted)}
  .warnrow{background:var(--surface-2);border-left:2px solid var(--warn);border-radius:0 6px 6px 0;
    padding:8px 10px;font-size:12.5px;color:var(--text-secondary);margin-top:10px}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Pitch Lab</h1>
  <div class="sub">Build a pitch from its spin, set the release and arm slot, throw it, and follow it all the way to where it arrives.</div>
</header>

<!-- ============ pitcher tabs ============ -->
<div class="ptabs" id="ptabs"></div>
<div class="toolbar">
  <input type="text" id="proName" placeholder="Pitcher name">
  <div class="seg" style="max-width:150px"><button id="phR" aria-pressed="true">RHP</button><button id="phL" aria-pressed="false">LHP</button></div>
  <button class="ghost" id="btnProNew">New</button>
  <button class="ghost" id="btnProDup">Duplicate</button>
  <button class="ghost" id="btnProDel">Delete</button>
  <span style="width:10px"></span>
  <button class="ghost" id="btnExport">Export (.json)</button>
  <button class="ghost" id="btnImport">Import</button>
  <input type="file" id="fileIn" accept="application/json,.json" hidden>
  <button class="ghost" id="btnRoster" title="Produce the one line to paste into the file so this roster ships with the page">Make built-in roster</button>
  <button class="ghost" id="btnReset" title="Throw away everything and go back to the pitchers this page ships with">Reset</button>
  <span class="sub" id="ioMsg" style="font-size:11.5px"></span>
  <div class="grow" style="flex:1 1 auto"></div>
  <span class="savetag" id="saveTag"></span>
</div>

<div id="rosterOut" hidden style="margin:-4px 0 10px">
  <div class="note" style="margin:0 0 6px">Open the HTML file in a text editor and find the one line that begins with <code>const TEAM_ROSTER</code>. Replace that whole line with the line below, and the page will open with these pitchers already loaded, for everyone who uses it. Repeat any time to update the roster.</div>
  <textarea id="rosterTxt" readonly spellcheck="false" style="width:100%;height:92px;background:var(--surface-2);
    color:var(--text-secondary);border:1px solid var(--line);border-radius:8px;padding:9px 11px;
    font:inherit;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;resize:vertical"></textarea>
  <div class="csvrow" style="margin-top:6px"><button class="ghost" id="btnRosterHide">Close</button>
    <span class="lb" id="rosterMsg"></span></div>
</div>

<!-- ============ CSV import ============ -->
<details class="csv" id="csvBox">
  <summary>Import an arsenal from a Rapsodo (or other) CSV <span class="hint">— groups pitch-by-pitch rows by pitch type and turns them into this pitcher's profile</span></summary>
  <div class="csvbody">
    <div class="csvrow">
      <button class="ghost" id="btnCsvPick">Choose a CSV file</button>
      <input type="file" id="csvFile" accept=".csv,.tsv,.txt,text/csv" hidden>
      <button class="ghost" id="btnCsvSample">Export a template</button>
      <span class="lb" id="csvInfo">Rapsodo "Pitch by Pitch" exports, TrackMan files and plain spreadsheets all work. Header junk at the top of the file is skipped automatically.</span>
    </div>
    <div id="csvPanel" hidden>
      <div class="note" style="margin:4px 0 2px"><b>1. Column mapping</b> — matched automatically. Fix anything that is wrong. "—" means the column is not used.</div>
      <div class="csvgrid" id="csvMap"></div>
      <div class="note" style="margin:8px 0 2px"><b>2. How to read it</b></div>
      <div class="csvrow">
        <span class="lb">Pitcher</span><select id="csvWho" style="width:auto;min-width:150px"></select>
        <span class="lb">Throws</span>
        <div class="seg" style="max-width:130px"><button id="csvHR" aria-pressed="true">RHP</button><button id="csvHL" aria-pressed="false">LHP</button></div>
        <span class="lb">Aggregate by</span>
        <div class="seg" style="max-width:160px"><button id="csvAvg" aria-pressed="true">Mean</button><button id="csvMed" aria-pressed="false">Median</button></div>
      </div>
      <div class="csvrow">
        <span class="lb">Velocity unit</span><select id="csvUv" style="width:auto"><option value="mph">mph</option><option value="kmh">km/h</option></select>
        <span class="lb">Break unit</span><select id="csvUb" style="width:auto"><option value="in">inches</option><option value="cm">cm</option></select>
        <span class="lb">Release unit</span><select id="csvUr" style="width:auto"><option value="ft">ft</option><option value="m">m</option><option value="cm">cm</option></select>
        <span class="lb">Spin direction as</span><select id="csvUt" style="width:auto"><option value="p">Pitcher view (Rapsodo)</option><option value="c">Catcher view (Statcast)</option></select>
      </div>
      <div class="csvrow">
        <label class="lb" style="display:flex;align-items:center;gap:5px"><input type="checkbox" id="csvFlip"> Horizontal sign is inverted (the pitches break the wrong way)</label>
        <label class="lb" style="display:flex;align-items:center;gap:5px"><input type="checkbox" id="csvJit" checked> Feed release scatter into section 4</label>
        <label class="lb" style="display:flex;align-items:center;gap:5px"><input type="checkbox" id="csvMin" checked> Skip pitch types with fewer than 3 pitches</label>
      </div>
      <div class="note" style="margin:8px 0 2px"><b>3. Pitch types to import</b> — click a row to include or exclude it.</div>
      <div style="overflow-x:auto"><table class="csvp" id="csvPrev"></table></div>
      <div class="csvrow" style="margin-top:11px">
        <button id="btnCsvNew">Import as a new pitcher</button>
        <button class="ghost" id="btnCsvRepl">Replace the current pitcher</button>
        <button class="ghost" id="btnCsvAdd">Add to the current pitcher</button>
        <span class="lb" id="csvMsg"></span>
      </div>
      <div class="note" id="csvWarn"></div>
    </div>
  </div>
</details>

<!-- ============ arsenal ============ -->
<div class="card" style="margin-bottom:10px">
  <div class="arshd">
    <h2>Arsenal — click a pitch to edit it</h2>
    <div style="display:flex;gap:7px;flex-wrap:wrap;align-items:center">
      <input type="text" id="pitchName" placeholder="Pitch name" style="background:var(--surface-2);color:var(--text-primary);
        border:1px solid var(--line);border-radius:7px;padding:5px 9px;font:inherit;font-size:12.5px;width:150px">
      <select id="addPitch" style="width:auto;min-width:210px"></select>
      <button class="ghost" id="btnDelPitch">Delete selected</button>
    </div>
  </div>
  <div class="chips" id="arsenal"></div>
  <div class="note">Pitches with the <b>T</b> box ticked are the ones laid out in section 4, Tunnel (the pitch being edited plus up to 3 more). Switching pitchers swaps the release settings and the whole arsenal together.<br>
  <b>Your work saves to this browser automatically</b> and is waiting for you next time you open the page &mdash; nothing is uploaded anywhere.
  It is tied to this one device and browser, so to carry it to another machine, or to hand it to a coach, use "Export (.json)" and "Import".
  "Reset" throws everything away and goes back to the pitchers this page ships with.</div>
</div>

<!-- ============ measured values ============ -->
<div class="card" style="margin-bottom:10px">
  <div class="arshd">
    <h2>Build the arsenal from measured numbers</h2>
    <div style="display:flex;gap:7px;flex-wrap:wrap;align-items:center">
      <span class="sub" style="font-size:11.5px">Spin direction as</span>
      <div class="seg" style="max-width:250px"><button id="mvC" aria-pressed="true">Catcher view</button><button id="mvP" aria-pressed="false">Pitcher view (Rapsodo)</button></div>
      <button class="ghost" id="btnMeasAll">All to measured</button>
      <button class="ghost" id="btnMeasNone">All to spin</button>
      <button class="ghost" id="btnMeasFill">Copy computed into measured</button>
    </div>
  </div>
  <div style="overflow-x:auto"><table class="tbl meas" id="measTable"></table></div>
  <div class="note">
  <b>Tick "Measured" on a pitch and the spin axis and spin efficiency are solved backwards from the vertical and horizontal break you type in.</b>
  That arsenal then drives all six sections — verdict, trajectory, arrival point, tunnel and tunnel search.<br>
  &bull; <b>Vert break</b> = IVB (induced vertical break, gravity removed); <b>Horz break</b> = HB. Both in inches. Enter horizontal break with <b>arm side positive</b> (for a RHP, movement toward the catcher's left is +). Rapsodo and Statcast sign conventions differ, so set the sign from which way the pitch actually breaks, not from the sign in the file.<br>
  &bull; <b>&Delta;Height, &Delta;Side, &Delta;Ext</b> are that one pitch's offset from the common release point set in section 2, in inches. Feeding in real quirks — a curveball released higher, say — changes how the tunnel looks.<br>
  &bull; If the spin rate cannot produce the break you typed, the row says "not enough spin" and shows the rate you would need.<br>
  &bull; Untick a pitch and it goes back to computing break from the spin axis and efficiency. <b>The MLB-average profile is left untouched.</b>
  </div>
</div>

<!-- ============ summary bar ============ -->
<div class="bar" id="bar"></div>

<!-- ============ 1 build the pitch ============ -->
<div class="sect">
  <div class="secthd"><span class="n">1</span><h2>Build the pitch</h2>
    <span class="d">Editing: <b id="editingName" style="color:var(--text-primary)">—</b> &nbsp;/&nbsp; set the spin axis, spin rate, efficiency and velocity, and see which MLB pitch profile it lands on.</span></div>
  <div class="g2">
    <div class="card">
      <canvas id="ball" width="760" height="540"></canvas>
      <div class="ctl">
        <div class="ctlrow"><label for="sPlay">Spin playback speed</label><output id="oPlay">0.05&times;</output></div>
        <input type="range" id="sPlay" min="1" max="100" value="5" step="1">
      </div>
      <div class="ctl dialwrap">
        <canvas class="dial" id="dial" width="252" height="252"></canvas>
        <div style="flex:1 1 auto;min-width:0">
          <div style="color:var(--text-secondary);font-size:12px">Spin axis (direction of break, catcher view)</div>
          <div class="big" id="oTilt">11:10</div>
          <div style="color:var(--text-muted);font-size:11.5px" id="oTiltSub"></div>
          <input type="range" id="sTilt" min="0" max="719" value="670" step="1" style="margin-top:8px">
          <div style="color:var(--text-muted);font-size:11px;margin-top:4px">You can also drag the clock face</div>
        </div>
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sRpm">Spin rate</label><output id="oRpm">2320 rpm</output></div>
        <input type="range" id="sRpm" min="600" max="3400" value="2320" step="10">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sEff">Spin efficiency (active spin)</label><output id="oEff">93 %</output></div>
        <input type="range" id="sEff" min="0" max="100" value="93" step="1">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sVelo">Velocity</label><output id="oVelo">94.2 mph</output></div>
        <input type="range" id="sVelo" min="600" max="1060" value="942" step="1">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label>Batter side (who is watching)</label></div>
        <div class="seg"><button id="bR" aria-pressed="true">RHB</button><button id="bL" aria-pressed="false">LHB</button></div>
      </div>
      <div class="note">The clock is the <b>direction the pitch breaks as the catcher and batter see it</b> — the same convention as MLB and Baseball Savant. Rapsodo and TrackMan report Tilt from the pitcher's view, which is mirrored left to right.</div>
    </div>

    <div>
      <div class="card">
        <h2>Closest MLB pitch type</h2>
        <div class="verdict">
          <div><div class="vname" id="vName">—</div><div class="vcode" id="vCode"></div></div>
          <div class="vpct" id="vPct">—</div>
        </div>
        <div class="ranks" id="ranks"></div>
        <div class="why" id="whySpin"></div>
      </div>
      <div class="card" style="margin-top:16px">
        <h2>Movement plot (batter's view, arm side to the right)</h2>
        <svg class="chart" id="mvChart" viewBox="0 0 640 400" role="img" aria-label="Break computed from spin, against the MLB reference pitch types"></svg>
        <div class="note">White dot = the current setting. Outlined dots = each MLB average profile run through the same model. The vertical axis is "how much less than a spinless ball it dropped", so a positive value still falls in absolute terms.</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 2 throw it ============ -->
<div class="sect">
  <div class="secthd"><span class="n">2</span><h2>Throw it</h2>
    <span class="d">Set the release height, arm slot and aim, and actually throw the pitch built in section 1.</span></div>
  <div class="g2b">
    <div class="card">
      <h2>Release</h2>
      <div class="ctl">
        <div class="ctlrow"><label for="sSlot">Arm slot angle</label><output id="oSlot"></output></div>
        <input type="range" id="sSlot" min="-15" max="95" value="60" step="1">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sHeight">Release height</label><output id="oHeight"></output></div>
        <input type="range" id="sHeight" min="120" max="225" value="184" step="1">
      </div>
      <div class="chk"><label for="cLinkH">Link height to arm slot</label><input type="checkbox" id="cLinkH" checked></div>
      <div class="ctl">
        <div class="ctlrow"><label for="sSide">Release side (arm side)</label><output id="oSide"></output></div>
        <input type="range" id="sSide" min="0" max="110" value="46" step="1">
      </div>
      <div class="chk"><label for="cLinkS">Link side to arm slot</label><input type="checkbox" id="cLinkS" checked></div>
      <div class="ctl">
        <div class="ctlrow"><label for="sExt">Extension</label><output id="oExt"></output></div>
        <input type="range" id="sExt" min="140" max="245" value="198" step="1">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sRub">Spot on the rubber</label><output id="oRub"></output></div>
        <input type="range" id="sRub" min="-28" max="28" value="0" step="1">
        <div class="rubbar"><i id="rubMark"></i></div>
        <div class="rubends"><span>&larr; 3B side</span><span>rubber 24"</span><span>1B side &rarr;</span></div>
      </div>
      <div class="note" style="margin-top:2px" id="relXNote"></div>
      <div class="chk"><label for="cLinkAxis">Derive the spin axis from the arm slot too</label><input type="checkbox" id="cLinkAxis"></div>

      <hr>
      <h2>Aim</h2>
      <div class="note" style="margin:0 0 8px">Aim = the direction that would land here <b>if the ball had no spin</b>. The real pitch ends up offset from it by exactly its break.</div>
      <div class="ctl">
        <div class="ctlrow"><label for="sAimX">Aim, horizontal (arm side + / glove side &minus;)</label><output id="oAimX"></output></div>
        <input type="range" id="sAimX" min="-70" max="70" value="0" step="1">
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sAimY">Aim, height</label><output id="oAimY"></output></div>
        <input type="range" id="sAimY" min="10" max="180" value="80" step="1">
      </div>
      <div class="btnrow">
        <button class="ghost" id="btnFit">Land it middle-middle</button>
      </div>
      <hr>
      <h2>Playback</h2>
      <div class="ctl">
        <div class="ctlrow"><label for="sPlaySpd">Playback speed</label><output id="oPlaySpd">0.25&times;</output></div>
        <input type="range" id="sPlaySpd" min="3" max="100" value="25" step="1">
        <div class="note" id="spdNote" style="margin-top:6px"></div>
        <div class="btnrow" style="margin-top:8px">
          <button class="ghost" id="btnRealSpd">Real speed (1.00&times;)</button>
          <button class="ghost" id="btnSlowSpd">Slow (0.10&times;)</button>
        </div>
      </div>
      <div class="chk"><label for="cSpin">Draw the spin on the incoming ball</label><input type="checkbox" id="cSpin" checked></div>
      <div class="ctl">
        <div class="ctlrow"><label for="sBallSc">Apparent ball size</label><output id="oBallSc">1.8&times;</output></div>
        <input type="range" id="sBallSc" min="10" max="40" value="18" step="1">
      </div>
      <div class="chk"><label for="cLoupe">Spin loupe (magnified)</label><input type="checkbox" id="cLoupe" checked></div>
      <div class="chk"><label for="cAxisShow">Draw the spin axis</label><input type="checkbox" id="cAxisShow"></div>
      <div class="chk"><label for="cPauseTun">Pause at the decision point (23.8 ft)</label><input type="checkbox" id="cPauseTun"></div>
      <div class="btnrow">
        <button class="primary" id="btnPlay">Throw (Space)</button>
        <button class="ghost" id="btnLoop" aria-pressed="false">Repeat: OFF</button>
      </div>
      <div class="note">Nobody actually tracks seams on a ball 60 feet away. Slow the playback down first until "this is how that pitch spins" is in your body, then put it back to 1.0&times;.</div>
    </div>

    <div>
      <div class="card">
        <div class="viewttl">Batter's view</div>
        <canvas id="v3d" width="900" height="540"></canvas>
        <div class="legend">
          <span><i class="sw" style="background:#3987e5"></i>actual path</span>
          <span><i class="sw" style="background:#c3c2b7"></i>no-spin path (= the aim)</span>
          <span><i class="sw" style="background:#eb6834"></i>release point and arm</span>
        </div>
        <div class="views">
          <div><div class="viewttl">Side view (vertical break)</div><canvas id="vSide" width="640" height="340"></canvas></div>
          <div><div class="viewttl">Top view (horizontal break)</div><canvas id="vTop" width="640" height="340"></canvas></div>
        </div>
      </div>
      <div class="card" style="margin-top:16px">
        <h2>Where it ends up</h2>
        <div class="kpis" id="kpis"></div>
        <div class="views" style="margin-top:14px">
          <div><div class="viewttl">Arrival point (strike zone, batter's view)</div><canvas id="vZone" width="480" height="440"></canvas></div>
          <div><div class="viewttl">What this pitch is</div><div class="why" id="whyRel" style="margin-top:0"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 3 compare ============ -->
<div class="sect">
  <div class="secthd"><span class="n">3</span><h2>Compare</h2>
    <span class="d">MLB reference values, and the arrival point as conditions are swept. Click a row to load that setting.</span></div>
  <div class="cols2">
    <div class="card">
      <h2>MLB average profiles</h2>
      <table class="tbl" id="refTable"></table>
      <div class="note">Velocity, spin rate, active spin and spin axis are approximate MLB averages. The break figures come from this page's own aerodynamic model, so they sit a few inches off the published Statcast numbers for some pitch types — real pitches carry seam-shifted wake and other non-Magnus effects.</div>
    </div>
    <div class="card">
      <h2>Sweep a condition</h2>
      <div class="seg" style="max-width:360px;margin-bottom:10px">
        <button id="cmpSlot" aria-pressed="true">By arm slot</button>
        <button id="cmpHeight" aria-pressed="false">By release height</button>
        <button id="cmpRub" aria-pressed="false">By rubber spot</button>
      </div>
      <table class="tbl" id="cmpTable"></table>
      <div class="note" id="cmpNote"></div>
    </div>
  </div>
  <div class="card" style="margin-top:16px">
    <h2>Numbers</h2>
    <div id="detail" style="font-size:12.5px"></div>
  </div>
</div>

<!-- ============ 4 tunnel ============ -->
<div class="sect">
  <div class="secthd"><span class="n">4</span><h2>See the tunnel</h2>
    <span class="d">Overlay several pitches from the same release and check how long they look identical to the batter.</span></div>
  <div class="g2b">
    <div class="card">
      <h2>Pitches on the board (up to 4)</h2>
      <div class="slots" id="slots"></div>
      <div class="note" id="slotNote" style="margin-top:8px"></div>
      <hr>
      <h2>How they are thrown</h2>
      <div class="seg" style="margin-bottom:8px">
        <button id="tmTunnel" aria-pressed="true">Share one tunnel</button>
        <button id="tmOwn" aria-pressed="false">Each to its own target</button>
        <button id="tmSame" aria-pressed="false">Identical arm direction</button>
      </div>
      <div class="note" id="modeNote" style="margin-top:0"></div>
      <div id="ownAim" hidden>
        <div class="ctl">
          <div class="ctlrow"><label for="sTAimX">Aim, horizontal (arm side +)</label><output id="oTAimX"></output></div>
          <input type="range" id="sTAimX" min="-70" max="70" value="0" step="1">
        </div>
        <div class="ctl">
          <div class="ctlrow"><label for="sTAimY">Aim, height</label><output id="oTAimY"></output></div>
          <input type="range" id="sTAimY" min="10" max="180" value="80" step="1">
        </div>
        <div class="btnrow"><button class="ghost" id="btnTFit">Put the edited pitch middle-middle</button></div>
      </div>
      <div class="ctl">
        <div class="ctlrow"><label for="sJit">Release scatter</label><output id="oJit">0"</output></div>
        <input type="range" id="sJit" min="0" max="10" value="0" step="1">
      </div>
      <div class="note" style="margin-top:6px">If the release point moves between pitch types, the batter picks them up out of the hand. 0 means a perfectly repeated arm action.</div>

      <hr>
      <h2>Where you are looking from</h2>
      <div class="ctl">
        <div class="ctlrow"><label for="sScrub">Distance from the plate</label><output id="oScrub"></output></div>
        <input type="range" id="sScrub" min="0" max="1800" value="725" step="5">
      </div>
      <div class="marks">
        <button class="ghost" data-jump="1650">Just released</button>
        <button class="ghost" data-jump="1200">39 ft</button>
        <button class="ghost" data-jump="725">Tunnel point</button>
        <button class="ghost" data-jump="0">The plate</button>
      </div>
      <div class="btnrow"><button class="primary" id="btnTPlay">Throw them together</button>
        <span class="sub" style="font-size:11.5px">playback speed and spin drawing come from section 2</span></div>
    </div>

    <div>
      <div class="card">
        <div class="viewttl">Batter's view — all pitches overlaid</div>
        <canvas id="vTun" width="900" height="540"></canvas>
        <div class="legend" id="tunLegend"></div>
      </div>
      <div class="card" style="margin-top:16px">
        <div class="views" style="margin-top:0">
          <div><div class="viewttl">Side view — vertical separation</div><canvas id="tSide" width="640" height="340"></canvas></div>
          <div><div class="viewttl">Top view — horizontal separation</div><canvas id="tTop" width="640" height="340"></canvas></div>
        </div>
        <div class="ctl" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
          <label class="ck" style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary);cursor:pointer">
            <input type="checkbox" id="cTunZoom" checked>Auto-zoom the vertical axis</label>
          <span class="sub" style="font-size:11.5px">blue line = decision point (23.8 ft) / white line = where you are looking</span>
        </div>
        <div class="note" style="margin-top:6px">If the paths are still on top of each other at the decision point, they are the same pitch as far as the batter is concerned. Zooming exaggerates the separation, so read it together with the cross-section below.</div>
      </div>

      <div class="card" style="margin-top:16px">
        <div class="views" style="margin-top:0">
          <div>
            <div class="viewttl" id="crossTtl">Tunnel cross-section</div>
            <canvas id="vCross" width="460" height="460"></canvas>
            <div class="note" style="margin-top:6px">A baseball is 2.9" across. While these circles still overlap, the batter is looking at the same pitch.</div>
          </div>
          <div>
            <div class="viewttl">Separation over distance (the two furthest apart)</div>
            <canvas id="vSep" width="460" height="300"></canvas>
            <div class="viewttl" style="margin-top:12px">Pair by pair</div>
            <table class="pair" id="pairTable"></table>
          </div>
        </div>
      </div>
    </div>
