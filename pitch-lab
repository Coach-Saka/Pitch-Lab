  });
  el.querySelectorAll('tr[data-i]').forEach(tr=>tr.onclick=e=>{
    if(e.target.tagName==='INPUT') return;
    const i=+tr.dataset.i; if(i===PRO().sel) return;
    saveToProfile(); PRO().sel=i; renderArsenal(); renderMeas(); loadProfile();
  });
}
function measEdit(i,f,el){
  const P=PRO(), a=P.arsenal[i]; if(!a) return;
  const num=v=>{const x=parseFloat(v); return isFinite(x)?x:0;};
  if(f==='name'){ a.name=el.value.trim()||'(untitled)'; }
  else if(f==='velo'){ a.velo=clamp(num(el.value),40,110); }
  else if(f==='rpm'){  a.rpm =clamp(num(el.value),300,3600); }
  else if(f==='eff'){  a.eff =clamp(num(el.value)/100,0,1); }
  else if(f==='tilt'){ const q=parseClock(el.value); if(q!==null) a.tilt=(measView==='p')?mirrorClock(q):q; }
  else if(f==='ivb'){  a.meas.ivb=clamp(num(el.value),-32,32); }
  else if(f==='hb'){   a.meas.hb =clamp(num(el.value),-32,32); }
  else if(f==='on'){
    a.meas.on=el.checked;
    if(a.meas.on && Math.abs(a.meas.ivb)<0.01 && Math.abs(a.meas.hb)<0.01){
      const m=calcMove(a,P.hand); a.meas.ivb=+m.ivb.toFixed(1); a.meas.hb=+m.hb.toFixed(1);
    }
  }
  else if(f==='dh'){ a.rel.dh=clamp(num(el.value),-24,24)*0.0254; }
  else if(f==='ds'){ a.rel.ds=clamp(num(el.value),-24,24)*0.0254; }
  else if(f==='de'){ a.rel.de=clamp(num(el.value),-24,24)*0.0254; }
  applyMeas(a,P.hand);
  a.fitted=false;
  if(i===P.sel){
    S.tilt=a.tilt; S.rpm=a.rpm; S.eff=a.eff; S.velo=a.velo;
    $('#sTilt').value=Math.round(S.tilt*60); $('#sRpm').value=Math.round(S.rpm);
    $('#sEff').value=Math.round(S.eff*100);  $('#sVelo').value=Math.round(S.velo*10);
  }
  update(); renderMeas(); renderArsenal();
}
/* re-solve the axis and efficiency when velocity or spin move while measured mode is on */
function resolveSel(){
  const a=CURP(); if(!(a&&a.meas&&a.meas.on)) return;
  a.velo=S.velo; a.rpm=S.rpm; applyMeas(a,PRO().hand);
  S.tilt=a.tilt; S.eff=a.eff;
  $('#sTilt').value=Math.round(S.tilt*60); $('#sEff').value=Math.round(S.eff*100);
}
/* editing the axis or efficiency directly turns measured mode off (they cannot both hold) */
function dropMeas(){ const a=CURP(); if(a&&a.meas) a.meas.on=false; }
function unlinkAxis(){ if(S.linkAxis){S.linkAxis=false; $('#cLinkAxis').checked=false;} }
function setSlot(v){
  S.slot=v; $('#sSlot').value=v;
  if(S.linkH){S.height=slotHeight(v); $('#sHeight').value=Math.round(S.height*100);}
  if(S.linkS){S.side=slotSide(v);   $('#sSide').value=Math.round(S.side*100);}
  if(S.linkAxis){S.tilt=S.hand===1?slotTilt(v):mirrorClock(slotTilt(v)); $('#sTilt').value=Math.round(S.tilt*60);}
}
function fitAim(){
  const rel=releasePoint(CURP()), sp=MPH(S.velo), P={tilt:S.tilt,rpm:S.rpm,eff:S.eff};
  const a=aimAt(rel,sp,{x:0,y:0.80},P,true);
  const ns=fly(rel,a.v,P,false,false).end;
  S.aimX=clamp(ns.x,-0.70,0.70); S.aimY=clamp(ns.y,0.10,1.80);
  $('#sAimY').value=Math.round(S.aimY*100);
  update();
}
function play(){
  anim.prevSim=null;
  if(anim.paused){ anim.paused=false; anim.didPause=true; anim.on=true;
    anim.t0=performance.now()-anim.pt/S.playSpeed*1000; return; }
  anim.on=true; anim.paused=false; anim.didPause=false; anim.t0=performance.now();
}

