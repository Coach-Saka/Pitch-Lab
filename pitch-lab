      if(S.linkS) S.side=slotSide(sl);
      if(S.linkAxis) S.tilt=S.hand===1?slotTilt(sl):mirrorClock(slotTilt(sl));
      const r=compute();
      h+='<tr data-slot="'+sl+'"'+(sl===save.slot?' class="cur"':'')+'>'+
        '<td class="nm">'+sl+'&deg; '+slotName(sl)+'</td><td>'+ftS(S.height)+'</td><td>'+clockStr(S.tilt)+'</td>'+
        '<td>'+(r.endArm>=0?'+':'')+IN(r.endArm).toFixed(0)+'"</td><td>'+inS(r.act.end.y)+'</td>'+
        '<td>'+r.vaa.toFixed(1)+'°</td><td style="color:'+(r.strike?'var(--good)':'var(--bad)')+'">'+
        (r.strike?'strike':'ball')+'</td></tr>';
    }
  }else{
    $('#cmpNote').innerHTML='Same spin and velocity, with the <b>arrival point pinned to the middle of the zone (31" high)</b> every time, sweeping release height only. '+
      'The aim (where a spinless ball would land) <b>barely moves as the release height changes</b>, because the break is the same. '+
      'What moves is the <b>approach angle (VAA)</b>: the lower the release, the flatter it gets. Same pitch to the same spot, '+
      'and the hitter sees the one from the lower slot as the one that rides.';
    S.linkH=false;
    h='<thead><tr><th>Rel ht</th><th>Aim height</th><th>Aim horz</th><th>VAA</th><th>HAA</th><th>Flight</th></tr></thead><tbody>';
