<script>
"use strict";
/* ============================================================
   shared: physics
   x = catcher's right, y = up, z = toward the pitcher (the ball travels toward -z)
   ============================================================ */
const MASS=0.145, RAD=0.0366, AREA=Math.PI*RAD*RAD, RHO=1.194;
const KA=0.5*RHO*AREA/MASS, GRAV=9.80665, CD=0.35, RUBBER=18.44, SPAN=15.24;
const MPH=v=>v*0.44704, MS2MPH=v=>v/0.44704, M2IN=m=>m/0.0254;
/* ---- display units: inches and feet ---- */
const IN   = m=>m/0.0254;                       // metres -> inches
const FT   = m=>m/0.3048;                       // metres -> feet
const inS  = (m,d)=>IN(m).toFixed(d===undefined?0:d)+'"';
const inSg = (m,d)=>{const v=IN(m); return (v>=0?'+':'')+v.toFixed(d===undefined?0:d)+'"';};
const ftS  = (m,d)=>FT(m).toFixed(d===undefined?2:d)+' ft';
const ZONE={x:0.2159, y0:0.50, y1:1.10};
const $=s=>document.querySelector(s);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function tiltDir(h){const a=h/12*2*Math.PI;return{x:Math.sin(a),y:Math.cos(a)};}

/* section 1: break over a ~50 ft span (difference from the no-spin path) */
function movement(veloMph,rpm,eff,tiltH){
  const v0=MPH(veloMph), wT=rpm*eff*2*Math.PI/60, d=tiltDir(tiltH);
  const run=(mag)=>{
    let p={x:0,y:0,z:0}, v={x:0,y:0,z:-v0}; const dt=0.0006;
    while(p.z>-SPAN){
      const sp=Math.hypot(v.x,v.y,v.z);
      const S=RAD*wT/sp, CL=S<=0.1?1.5*S:0.09+0.6*S, ad=-KA*CD*sp;
      let ax=ad*v.x, ay=ad*v.y-GRAV, az=ad*v.z;
      if(mag){const am=KA*CL*sp*sp; ax+=am*d.x; ay+=am*d.y;}
      v.x+=ax*dt;v.y+=ay*dt;v.z+=az*dt;p.x+=v.x*dt;p.y+=v.y*dt;p.z+=v.z*dt;
    }
    return p;
  };
  const a=run(true), b=run(false);
  return {hbCatcher:M2IN(a.x-b.x), ivb:M2IN(a.y-b.y)};
}
/* arm side + <-> world x (for a RHP the arm side is the catcher's left, i.e. x negative) */
const armToWorld=(v,hand)=> hand===1 ? -v : v;
/* break (IVB vertical, HB horizontal in catcher-view x, inches) -> solve the spin axis (clock) and efficiency */
function solveSpin(velo,rpm,ivbT,hbCT){
  const R=Math.hypot(hbCT,ivbT);
  if(!(R>0.02)) return {tilt:12, eff:0.01, ok:true, need:Math.round(rpm*0.01), effRaw:0.01};
  let h=Math.atan2(hbCT,ivbT)/(2*Math.PI)*12; if(h<=0)h+=12;
  const m1=movement(velo,rpm,0.6,h), r1=Math.hypot(m1.hbCatcher,m1.ivb);
  let eff=clamp(0.6*R/Math.max(r1,0.05),0.01,1.8);
  for(let it=0;it<12;it++){
    const m=movement(velo,rpm,eff,h);
    const ex=m.hbCatcher-hbCT, ey=m.ivb-ivbT;
    if(Math.hypot(ex,ey)<0.02) break;
    const dh=0.02, de=0.008;
    const mh=movement(velo,rpm,eff,h+dh), me=movement(velo,rpm,eff+de,h);
    const J=[[(mh.hbCatcher-m.hbCatcher)/dh,(me.hbCatcher-m.hbCatcher)/de],
             [(mh.ivb      -m.ivb      )/dh,(me.ivb      -m.ivb      )/de]];
    const det=J[0][0]*J[1][1]-J[0][1]*J[1][0];
    if(!isFinite(det)||Math.abs(det)<1e-9) break;
    const nh = h   - ( J[1][1]*ex - J[0][1]*ey)/det;
    const ne = eff - (-J[1][0]*ex + J[0][0]*ey)/det;
    if(!isFinite(nh)||!isFinite(ne)) break;
    eff=clamp(ne,0.005,1.8);
    h=((nh%12)+12)%12; if(h<=0.0001)h=12;
  }
  return {tilt:h, eff:clamp(eff,0.005,1), ok:eff<=1.005, need:Math.round(rpm*eff), effRaw:eff};
}
/* a pitch carrying measured break: rebuild its axis and efficiency from those numbers */
function applyMeas(a,hand){
  if(!a||!a.meas||!a.meas.on) return;
  const r=solveSpin(a.velo,a.rpm,a.meas.ivb,armToWorld(a.meas.hb,hand));
  a.tilt=r.tilt; a.eff=r.eff; a.meas.ok=r.ok; a.meas.need=r.need; a.fitted=false;
}
/* break computed from the spin (arm side +, inches) */
function calcMove(a,hand){
  const m=movement(a.velo,a.rpm,a.eff,a.tilt);
  return {ivb:m.ivb, hb:armToWorld(m.hbCatcher,hand)};
}
/* section 2: flight from the release point to the plate */
function fly(rel,vel0,P,magnus,keep){
  const wT=P.rpm*P.eff*2*Math.PI/60, d=tiltDir(P.tilt);
  let p={x:rel.x,y:rel.y,z:rel.z}, v={x:vel0.x,y:vel0.y,z:vel0.z};
  const dt=0.0005; let t=0; const path=keep?[{x:p.x,y:p.y,z:p.z,t:0}]:null;
  while(p.z>0 && t<2.2){
    const sp=Math.hypot(v.x,v.y,v.z);
    const S=RAD*wT/sp, CL=S<=0.1?1.5*S:0.09+0.6*S, ad=-KA*CD*sp;
    let ax=ad*v.x, ay=ad*v.y-GRAV, az=ad*v.z;
    if(magnus){const am=KA*CL*sp*sp; ax+=am*d.x; ay+=am*d.y;}
    v.x+=ax*dt; v.y+=ay*dt; v.z+=az*dt;
    p.x+=v.x*dt; p.y+=v.y*dt; p.z+=v.z*dt; t+=dt;
    if(path) path.push({x:p.x,y:p.y,z:p.z,t});
  }
  return {end:{x:p.x,y:p.y,z:p.z}, vel:v, t, path};
}
function aimAt(rel,speed,target,P,magnus){
  let el=Math.atan2(target.y-rel.y, rel.z), az=Math.atan2(target.x-rel.x, rel.z);
  const mk=(e,a)=>({x:speed*Math.sin(a)*Math.cos(e), y:speed*Math.sin(e), z:-speed*Math.cos(a)*Math.cos(e)});
  for(let i=0;i<8;i++){
    const f=fly(rel,mk(el,az),P,magnus,false).end;
    const ex=f.x-target.x, ey=f.y-target.y;
    if(Math.hypot(ex,ey)<0.0005) break;
    const h=1e-4;
    const fa=fly(rel,mk(el,az+h),P,magnus,false).end;
    const fe=fly(rel,mk(el+h,az),P,magnus,false).end;
    const J=[[(fa.x-f.x)/h,(fe.x-f.x)/h],[(fa.y-f.y)/h,(fe.y-f.y)/h]];
    const det=J[0][0]*J[1][1]-J[0][1]*J[1][0];
    if(Math.abs(det)<1e-10) break;
    az-=( J[1][1]*ex - J[0][1]*ey)/det;
    el-=(-J[1][0]*ex + J[0][0]*ey)/det;
  }
  return {v:mk(el,az), el, az};
}
