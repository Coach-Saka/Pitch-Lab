  ctx.strokeStyle='rgba(255,255,255,.45)'; ctx.lineWidth=2;
  ctx.strokeRect(X(-ZONE.x),Y(ZONE.y1),X(ZONE.x)-X(-ZONE.x),Y(ZONE.y0)-Y(ZONE.y1));
  ctx.strokeStyle='rgba(255,255,255,.13)'; ctx.lineWidth=1;
  for(let i=1;i<3;i++){
