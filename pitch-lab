    let sc=0; CSVF.forEach(f=>{ let m=0; r.forEach(h=>{m=Math.max(m,headScore(h,f));}); sc+=m; });
    sc+=r.length*0.5;
    if(sc>bs){bs=sc;bi=i;}
  }
  return bi;
}
