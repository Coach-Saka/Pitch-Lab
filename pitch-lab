    const a={x:c[0].x+(c[1].x-c[0].x)*i/3,y:c[0].y+(c[1].y-c[0].y)*i/3};
    const b={x:c[3].x+(c[2].x-c[3].x)*i/3,y:c[3].y+(c[2].y-c[3].y)*i/3};
    x3.beginPath();x3.moveTo(a.x,a.y);x3.lineTo(b.x,b.y);x3.stroke();
    const d={x:c[0].x+(c[3].x-c[0].x)*i/3,y:c[0].y+(c[3].y-c[0].y)*i/3};
    const e={x:c[1].x+(c[2].x-c[1].x)*i/3,y:c[1].y+(c[2].y-c[1].y)*i/3};
    x3.beginPath();x3.moveTo(d.x,d.y);x3.lineTo(e.x,e.y);x3.stroke();
  }
}
/* --- side view / top view --- */
function draw2(id,horiz){
  const cv=$(id), ctx=cv.getContext('2d');
  const r=cv.getBoundingClientRect(), dp=Math.min(2,window.devicePixelRatio||1);
  const W=Math.round(r.width)||640, H=Math.round(W*0.53);
  cv.width=W*dp; cv.height=H*dp; cv.style.height=H+'px'; ctx.setTransform(dp,0,0,dp,0,0);
  ctx.fillStyle='#0b0f14'; ctx.fillRect(0,0,W,H);
  const m={l:34,r:14,t:14,b:26}, Z0=19.2;
  const X=z=>m.l+(Z0-z)/Z0*(W-m.l-m.r);
  const Ymin=horiz?-1.3:0, Ymax=horiz?1.3:2.6;
  const Y=v=>m.t+(Ymax-v)/(Ymax-Ymin)*(H-m.t-m.b);
  ctx.strokeStyle='#262622'; ctx.lineWidth=1;
  for(let z=0;z<=18;z+=3){ctx.beginPath();ctx.moveTo(X(z),m.t);ctx.lineTo(X(z),H-m.b);ctx.stroke();}
  for(let v=Ymin;v<=Ymax+1e-9;v+=0.5){ctx.beginPath();ctx.moveTo(m.l,Y(v));ctx.lineTo(W-m.r,Y(v));ctx.stroke();}
  ctx.fillStyle='#8f8e85'; ctx.font='10px sans-serif'; ctx.textAlign='center';
  for(let z=0;z<=18;z+=6) ctx.fillText(FT(z).toFixed(0)+' ft',X(z),H-8);
  ctx.textAlign='right';
  for(let v=Ymin;v<=Ymax+1e-9;v+=1) ctx.fillText(FT(v).toFixed(0),m.l-5,Y(v)+3);
  ctx.strokeStyle='#4a4a43'; ctx.lineWidth=1.4;
  ctx.beginPath(); ctx.moveTo(m.l,Y(0)); ctx.lineTo(W-m.r,Y(0)); ctx.stroke();
  ctx.strokeStyle='rgba(255,255,255,.4)'; ctx.lineWidth=2; ctx.beginPath();
  if(horiz){ ctx.moveTo(X(0),Y(-ZONE.x)); ctx.lineTo(X(0),Y(ZONE.x)); }
  else { ctx.moveTo(X(0),Y(ZONE.y0)); ctx.lineTo(X(0),Y(ZONE.y1)); }
  ctx.stroke();
  if(!RES) return;
  const val=p=>horiz?armSign(p.x):p.y;
  const line=(path,col,lw,dash)=>{
    ctx.strokeStyle=col; ctx.lineWidth=lw; if(dash)ctx.setLineDash(dash);
    ctx.beginPath();
    for(let i=0;i<path.length;i+=4){const p=path[i]; i?ctx.lineTo(X(p.z),Y(val(p))):ctx.moveTo(X(p.z),Y(val(p)));}
    ctx.stroke(); ctx.setLineDash([]);
  };
  line(RES.noSpin.path,'rgba(195,194,183,.6)',1.6,[5,5]);
  line(RES.act.path,'#3987e5',2.2,null);
  ctx.fillStyle='#eb6834'; ctx.beginPath(); ctx.arc(X(RES.rel.z),Y(val(RES.rel)),4,0,7); ctx.fill();
  ctx.fillStyle=RES.strike?'#199e70':'#e66767';
  ctx.beginPath(); ctx.arc(X(0),Y(val(RES.act.end)),5,0,7); ctx.fill();
  ctx.fillStyle='#8f8e85'; ctx.font='10.5px sans-serif'; ctx.textAlign='left';
  ctx.fillText(horiz?'up: arm side / down: glove side (ft)':'height (ft)', m.l+4, m.t+11);
}
