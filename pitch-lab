/* ============================================================
   section 5: tunnel search by purpose
   ============================================================ */
const ZX=ZONE.x+RAD, ZY0=ZONE.y0-RAD, ZY1=ZONE.y1+RAD;
function zoneInfo(pt){
  const outX=Math.max(0,Math.abs(pt.x)-ZX);
  const outY=Math.max(0, Math.max(ZY0-pt.y, pt.y-ZY1));
  const miss=Math.hypot(outX,outY);
  const inside=miss<=1e-6;
  const margin=inside?Math.min(ZX-Math.abs(pt.x), pt.y-ZY0, ZY1-pt.y):0;
  return {inside, miss, margin};
}
/* course name from the batter's point of view (inside = the batter's side) */
function locName(pt){
  const ins = S.batter===-1 ? -pt.x : pt.x;
  const h = pt.y>ZY1 ? 'above' : pt.y>ZONE.y0+(ZONE.y1-ZONE.y0)*0.66 ? 'up'
          : pt.y>ZONE.y0+(ZONE.y1-ZONE.y0)*0.33 ? 'middle' : pt.y>ZY0 ? 'down' : 'below';
  const w = ins> ZX ? 'off inside' : ins> ZONE.x*0.33 ? 'in'
          : ins> -ZONE.x*0.33 ? 'middle' : ins> -ZX ? 'away' : 'off away';
  return (h==='middle'&&w==='middle') ? 'middle-middle' : h+' / '+w;
}
const bell=(v,c,w)=>Math.exp(-Math.pow((v-c)/w,2));
const ramp=(v,a,b)=>clamp((v-a)/(b-a),0,1);

const SCEN=[
 {id:'k', name:'Strikeout (two strikes)',
  desc:'Setup pitch is a strike, the finisher misses the zone by 4-10 inches. With the hitter put away, a bigger miss still gets swung at.',
  score(A,B,sep,dAng){
    const za=zoneInfo(A), zb=zoneInfo(B);
    if(!za.inside || zb.inside) return 0;
    const s1=0.5+0.5*bell(za.margin*100,8,8);          // setup is in the zone but not too fat
    const s2=bell(zb.miss*100,15,11);                   // finisher misses by 4-10 in
    const s3=ramp(sep*100,14,36);                       // arrival points well apart
    const s4=bell(dAng,0,2.6);                          // small release-angle gap
    const s5=B.y<A.y?1:0.78;                            // easier to get a swing if the finisher drops below
    return s1*s2*s3*s4*s5;
  }},
 {id:'strike', name:'Strike when behind',
  desc:'Both pitches are strikes. Either one lands, so you get ahead without being picked up.',
  desc2:'3-0, 2-0 and the like',
  score(A,B,sep,dAng){
    const za=zoneInfo(A), zb=zoneInfo(B);
    if(!za.inside || !zb.inside) return 0;
    const s1=ramp(za.margin*100,0.5,5);
    const s2=ramp(zb.margin*100,0.5,5);
    const s3=ramp(sep*100,10,26);                       // far enough apart to be two different pitches
    const s4=bell(dAng,0,2.6);
    return s1*s2*s3*s4;
  }},
 {id:'chase', name:'Chase when behind',
  desc:'Setup pitch is a strike, the finisher misses the zone by only 1-5 inches. A borderline call if taken, a whiff if swung at.',
  score(A,B,sep,dAng){
    const za=zoneInfo(A), zb=zoneInfo(B);
    if(!za.inside || zb.inside) return 0;
    const s1=ramp(za.margin*100,1,6);
    const s2=bell(zb.miss*100,6,5.5);                    // miss by a hair
    const s3=ramp(sep*100,13,32);
    const s4=bell(dAng,0,2.0);                           // arm action has to match especially well here
    return s1*s2*s3*s4;
  }},
 {id:'weak', name:'Induce weak contact',
  desc:'Both pitches down. Looks for a pair the bat reaches but the barrel does not. For getting outs without spending pitches.',
  score(A,B,sep,dAng){
    const za=zoneInfo(A), zb=zoneInfo(B);
    if(!za.inside) return 0;
    if(A.y>ZONE.y0+(ZONE.y1-ZONE.y0)*0.5) return 0;      // setup has to be in the lower half
    const s1=ramp(za.margin*100,0.5,5);
    const s2=zb.inside?1:bell(zb.miss*100,4,6);           // finisher in the zone or barely off it
    const s3=bell(sep*100,22,15);
    const s4=bell(dAng,0,2.6);
    const s5=B.y<=A.y+0.03?1:0.72;
    return s1*s2*s3*s4*s5;
  }},
];
