/* --- cross-section --- */
function drawCross(){
  const cv=$('#vCross'), ctx=cv.getContext('2d');
  const r=cv.getBoundingClientRect(), dp=Math.min(2,window.devicePixelRatio||1);
  const W=Math.round(r.width)||460, H=Math.round(W*0.86);
  cv.width=W*dp; cv.height=H*dp; cv.style.height=H+'px'; ctx.setTransform(dp,0,0,dp,0,0);
  ctx.fillStyle='#0b0f14'; ctx.fillRect(0,0,W,H);
  if(!TUNRES||!TUNRES.length) return;
  const pts=TUNRES.map(r=>({r,p:atDist(r,TUN.scrub)}));
  const cx0=pts.reduce((a,b)=>a+b.p.x,0)/pts.length, cy0=pts.reduce((a,b)=>a+b.p.y,0)/pts.length;
  const spread=Math.max(0.12, ...pts.map(q=>Math.hypot(q.p.x-cx0,q.p.y-cy0)))*2.8;
  const win=Math.max(0.42, spread);          // view window (m)
  const X=x=>W/2+(x-cx0)/win*W, Y=y=>H/2-(y-cy0)/win*H;
  // grid (4 in)
  ctx.strokeStyle='#262622'; ctx.lineWidth=1;
  for(let k=-10;k<=10;k++){
    const v=k*0.1016;
    ctx.beginPath();ctx.moveTo(X(cx0+v),0);ctx.lineTo(X(cx0+v),H);ctx.stroke();
    ctx.beginPath();ctx.moveTo(0,Y(cy0+v));ctx.lineTo(W,Y(cy0+v));ctx.stroke();
  }
  ctx.fillStyle='#8f8e85'; ctx.font='11px sans-serif'; ctx.textAlign='left';
  ctx.fillText('grid 4" / window '+IN(win).toFixed(0)+'" across',10,18);
  ctx.textAlign='right';
  ctx.fillText(FT(TUN.scrub).toFixed(1)+' ft to the plate',W-10,18);
  const rad=RAD/win*W;
  pts.forEach(q=>{ ctx.fillStyle='rgba(242,239,233,.55)';
    ctx.beginPath(); ctx.arc(X(q.p.x),Y(q.p.y),rad,0,7); ctx.fill(); });
  // nudge each outline inward a little so every ball stays visible when they overlap
  pts.forEach((q,i)=>{
    const rr=rad*(1-0.085*i);
    ctx.strokeStyle=q.r.color; ctx.lineWidth=Math.max(2,rad*0.13);
    ctx.beginPath(); ctx.arc(X(q.p.x),Y(q.p.y),rr,0,7); ctx.stroke();
  });
  // labels listed top-left so they stay readable when the circles overlap
  ctx.textAlign='left'; ctx.font='600 11.5px sans-serif';
  pts.forEach((q,i)=>{
    const yy=36+i*17;
    ctx.fillStyle=q.r.color; ctx.fillRect(10,yy-8,10,10);
    ctx.fillStyle='#c3c2b7'; ctx.fillText(q.r.name,26,yy);
  });
  const sep=maxSepAt(TUN.scrub)*100;
  ctx.fillStyle= sep<7.3 ? '#199e70' : (sep<20?'#c98500':'#e66767');
  ctx.font='600 13px sans-serif'; ctx.textAlign='left';
  ctx.fillText('widest gap '+IN(sep/100).toFixed(1)+'"'+(sep<7.3?' (less than one ball \u2014 they look the same)':''),10,H-12);
}
/* --- separation graph --- */
function drawSep(){
  const cv=$('#vSep'), ctx=cv.getContext('2d');
  const r=cv.getBoundingClientRect(), dp=Math.min(2,window.devicePixelRatio||1);
  const W=Math.round(r.width)||460, H=Math.round(W*0.62);
  cv.width=W*dp; cv.height=H*dp; cv.style.height=H+'px'; ctx.setTransform(dp,0,0,dp,0,0);
  ctx.fillStyle='#0b0f14'; ctx.fillRect(0,0,W,H);
  if(!TUNRES||TUNRES.length<2) return;
  const m={l:38,r:12,t:14,b:26}, D0=17.5;
  const sample=[];
  for(let d=D0;d>=0;d-=0.25) sample.push({d,s:maxSepAt(d)*100});
  const maxS=Math.max(20,Math.ceil(Math.max(...sample.map(q=>q.s))/10)*10);
  const X=d=>m.l+(D0-d)/D0*(W-m.l-m.r), Y=v=>H-m.b-v/maxS*(H-m.t-m.b);
  ctx.strokeStyle='#262622'; ctx.lineWidth=1;
  for(let d=0;d<=17;d+=3){ctx.beginPath();ctx.moveTo(X(d),m.t);ctx.lineTo(X(d),H-m.b);ctx.stroke();}
  for(let v=0;v<=maxS;v+=maxS/4){ctx.beginPath();ctx.moveTo(m.l,Y(v));ctx.lineTo(W-m.r,Y(v));ctx.stroke();}
  ctx.fillStyle='#8f8e85'; ctx.font='10px sans-serif'; ctx.textAlign='center';
  for(let d=0;d<=17;d+=6) ctx.fillText(FT(d).toFixed(0)+' ft',X(d),H-8);
  ctx.textAlign='right';
  for(let v=0;v<=maxS;v+=maxS/4) ctx.fillText(IN(v/100).toFixed(1),m.l-5,Y(v)+3);
  // one-ball reference
  ctx.strokeStyle='rgba(25,158,112,.55)'; ctx.setLineDash([4,4]); ctx.lineWidth=1.4;
  ctx.beginPath(); ctx.moveTo(m.l,Y(7.3)); ctx.lineTo(W-m.r,Y(7.3)); ctx.stroke(); ctx.setLineDash([]);
  ctx.fillStyle='#199e70'; ctx.textAlign='left'; ctx.font='10px sans-serif';
  ctx.fillText('one ball (2.9")',m.l+4,Y(7.3)-4);
  // tunnel point
  ctx.strokeStyle='rgba(195,194,183,.45)'; ctx.lineWidth=1.2; ctx.setLineDash([3,4]);
  ctx.beginPath(); ctx.moveTo(X(TUNNEL_M),m.t); ctx.lineTo(X(TUNNEL_M),H-m.b); ctx.stroke(); ctx.setLineDash([]);
  ctx.fillStyle='#c3c2b7'; ctx.textAlign='center'; ctx.fillText('decision point',X(TUNNEL_M),m.t+10);
  // curve
  ctx.strokeStyle='#3987e5'; ctx.lineWidth=2.2; ctx.beginPath();
  sample.forEach((q,i)=>i?ctx.lineTo(X(q.d),Y(q.s)):ctx.moveTo(X(q.d),Y(q.s)));
  ctx.stroke();
  // current position
  const cs=maxSepAt(TUN.scrub)*100;
  ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(X(TUN.scrub),Y(cs),5,0,7); ctx.fill();
  ctx.strokeStyle='#3987e5'; ctx.lineWidth=2.5; ctx.stroke();
  ctx.fillStyle='#8f8e85'; ctx.textAlign='left'; ctx.font='10.5px sans-serif';
  ctx.fillText('separation (in)',m.l+4,m.t+10);
}
