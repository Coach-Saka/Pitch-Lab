      const a=aimAt(rel,sp,{x:0,y:0.80},P,true);
      const ns=fly(rel,a.v,P,false,false).end;
      S.aimX=ns.x; S.aimY=ns.y;
      const r=compute(), aimArm=armSign(ns.x)*100;
      const cross=Math.abs(rel.x)*100;
      h+='<tr data-rub="'+rb+'"'+(Math.abs(rb-save.rub)<0.005?' class="cur"':'')+'>'+
        '<td class="nm">'+(rb===0?'centre':Math.abs(IN(rb)).toFixed(0)+'" '+(rb<0?'3B side':'1B side'))+'</td>'+
        '<td>'+Math.abs(IN(rel.x)).toFixed(0)+'" '+(rel.x<0?'3B':'1B')+'</td>'+
