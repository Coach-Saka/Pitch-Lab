$('#sVelo').oninput=e=>{S.velo=+e.target.value/10; resolveSel(); update();};
$('#sPlay').oninput=e=>{S.play=+e.target.value/100; $('#oPlay').textContent=S.play.toFixed(2)+'×';};
$('#sSlot').oninput=e=>{setSlot(+e.target.value); update();};
$('#sHeight').oninput=e=>{S.height=+e.target.value/100; S.linkH=false; $('#cLinkH').checked=false; update();};
$('#sSide').oninput=e=>{S.side=+e.target.value/100; S.linkS=false; $('#cLinkS').checked=false; update();};
$('#sExt').oninput=e=>{S.ext=+e.target.value/100; update();};
$('#sRub').oninput=e=>{S.rub=+e.target.value/100; update();};
$('#sAimX').oninput=e=>{S.aimX=-(+e.target.value)/100*S.hand; update();};
$('#sAimY').oninput=e=>{S.aimY=+e.target.value/100; update();};
$('#cLinkH').onchange=e=>{S.linkH=e.target.checked; if(S.linkH)setSlot(S.slot); update();};
$('#cLinkS').onchange=e=>{S.linkS=e.target.checked; if(S.linkS)setSlot(S.slot); update();};
$('#cLinkAxis').onchange=e=>{S.linkAxis=e.target.checked; if(S.linkAxis)setSlot(S.slot); update();};
$('#btnFit').onclick=()=>{fitAim(); play();};
$('#btnPlay').onclick=play;
function spdLabel(){
  $('#oPlaySpd').innerHTML=S.playSpeed.toFixed(2)+'×'+
    (S.playSpeed>=0.999?'<small style="color:var(--good)">real</small>'
                       :'<small>'+(1/S.playSpeed).toFixed(1)+'x slower</small>');
}
function updSpdNote(){
  const T=RES?RES.act.t:0.41, wall=T/S.playSpeed, frames=Math.round(wall*60);
  spdLabel();
  $('#spdNote').innerHTML='<b style="color:var(--text-secondary)">1.00&times; is real time.</b> '+
    'This pitch\'s <b style="color:var(--text-secondary)">'+(T*1000).toFixed(0)+' ms</b> flight is played back over '+
    (wall>=1?wall.toFixed(2)+' s':(wall*1000).toFixed(0)+' ms')+' on screen (about '+frames+' frames at 60 fps). '+
    (S.playSpeed>=0.999
      ? 'At real speed there are only about '+frames+' frames in the whole pitch, so each frame of motion is split into sub-steps and layered as a faint trail to get closer to how it actually looks.'
      : '');
}
$('#btnRealSpd').onclick=()=>{ const el=$('#sPlaySpd'); el.value=100; el.dispatchEvent(new Event('input')); play(); };
$('#btnSlowSpd').onclick=()=>{ const el=$('#sPlaySpd'); el.value=10; el.dispatchEvent(new Event('input')); play(); };
$('#sPlaySpd').oninput=e=>{
  const v=+e.target.value/100;
  if(anim.on&&!anim.paused){ const sim=(performance.now()-anim.t0)/1000*S.playSpeed;
    anim.t0=performance.now()-sim/v*1000; }
  if(TUN.anim.on){ const sim=(performance.now()-TUN.anim.t0)/1000*S.playSpeed;
    TUN.anim.t0=performance.now()-sim/v*1000; }
  S.playSpeed=v; updSpdNote();
};
$('#cSpin').onchange=e=>S.spinDraw=e.target.checked;
$('#sBallSc').oninput=e=>{S.ballScale=+e.target.value/10; $('#oBallSc').textContent=S.ballScale.toFixed(1)+'×';};
$('#cLoupe').onchange=e=>S.loupe=e.target.checked;
$('#cAxisShow').onchange=e=>S.spinAxisShow=e.target.checked;
$('#cPauseTun').onchange=e=>{S.pauseTun=e.target.checked; if(!S.pauseTun) anim.paused=false;};
$('#btnLoop').onclick=e=>{S.loop=!S.loop; e.target.setAttribute('aria-pressed',String(S.loop));
  e.target.textContent='Repeat: '+(S.loop?'ON':'OFF'); if(S.loop)play();};
function setCmp(m){
  cmpMode=m;
  [['slot','#cmpSlot'],['height','#cmpHeight'],['rub','#cmpRub']].forEach(q=>{
    const el=$(q[1]); if(el) el.setAttribute('aria-pressed',String(q[0]===m));
  });
  renderCmpTable();
}
$('#cmpSlot').onclick=()=>setCmp('slot');
$('#cmpHeight').onclick=()=>setCmp('height');
$('#cmpRub')&&($('#cmpRub').onclick=()=>setCmp('rub'));
function setHand(h){
  if(S.hand===h) return;
  const P=PRO();
  S.hand=h; P.hand=h;
  S.rub=-S.rub; P.release.rub=S.rub; $('#sRub').value=Math.round(S.rub*100);
  P.arsenal.forEach(a=>{ a.tilt=mirrorClock(a.tilt); a.aimX=-a.aimX; a.fitted=false; applyMeas(a,h); });
  S.tilt=mirrorClock(S.tilt); S.aimX=-S.aimX;
  $('#phR').setAttribute('aria-pressed',String(h===1));
  $('#phL').setAttribute('aria-pressed',String(h===-1));
  $('#sTilt').value=Math.round(S.tilt*60);
  refreshTypes(); renderRefTable(); renderTabs(); renderArsenal(); renderMeas(); fitAim();
}
$('#abR').onclick=()=>{S.batter=-1;$('#abR').setAttribute('aria-pressed','true');$('#abL').setAttribute('aria-pressed','false');
  $('#bR').setAttribute('aria-pressed','true');$('#bL').setAttribute('aria-pressed','false');setupCam();update();runAnalysis();};
$('#abL').onclick=()=>{S.batter=1;$('#abL').setAttribute('aria-pressed','true');$('#abR').setAttribute('aria-pressed','false');
  $('#bL').setAttribute('aria-pressed','true');$('#bR').setAttribute('aria-pressed','false');setupCam();update();runAnalysis();};
$('#phR').onclick=()=>setHand(1);
$('#phL').onclick=()=>setHand(-1);

/* ---- measured-values table controls ---- */
function setMeasView(v){
  measView=v;
  $('#mvC').setAttribute('aria-pressed',String(v==='c'));
  $('#mvP').setAttribute('aria-pressed',String(v==='p'));
  renderMeas();
}
$('#mvC').onclick=()=>setMeasView('c');
$('#mvP').onclick=()=>setMeasView('p');
$('#btnMeasAll').onclick=()=>{
  saveToProfile();
  const P=PRO();
  P.arsenal.forEach(a=>{
    if(Math.abs(a.meas.ivb)<0.01 && Math.abs(a.meas.hb)<0.01){
      const m=calcMove(a,P.hand); a.meas.ivb=+m.ivb.toFixed(1); a.meas.hb=+m.hb.toFixed(1);
    }
    a.meas.on=true; applyMeas(a,P.hand);
  });
  const a=CURP(); S.tilt=a.tilt; S.eff=a.eff;
  $('#sTilt').value=Math.round(S.tilt*60); $('#sEff').value=Math.round(S.eff*100);
  update(); renderMeas(); renderArsenal();
};
$('#btnMeasNone').onclick=()=>{
  saveToProfile();
  PRO().arsenal.forEach(a=>{ a.meas.on=false; });
  update(); renderMeas(); renderArsenal();
};
$('#btnMeasFill').onclick=()=>{
  saveToProfile();
  const P=PRO();
  P.arsenal.forEach(a=>{ const m=calcMove(a,P.hand);
    a.meas.ivb=+m.ivb.toFixed(1); a.meas.hb=+m.hb.toFixed(1); });
  renderMeas();
};

/* ---- profile controls ---- */
$('#proName').oninput=e=>{ PRO().name=e.target.value||'(untitled)'; renderTabs(); };
$('#pitchName').oninput=e=>{ const a=CURP(); if(!a)return; a.name=e.target.value||'(untitled)';
  $('#editingName').textContent=a.name; renderArsenal(); renderSlots(); updateTunnel(); };
$('#btnProNew').onclick=()=>{
  saveToProfile();
  PROFILES.push(mkProfile('New pitcher',1,{},[mkPitch('4-Seam',11+10/60,2320,0.93,94.2,true)]));
  PI=PROFILES.length-1; renderTabs(); renderArsenal(); loadProfile();
};
$('#btnProDup').onclick=()=>{
  saveToProfile();
  const c=JSON.parse(JSON.stringify(PRO()));
  c.uid=uid++; c.name=c.name+' (copy)'; c.arsenal.forEach(a=>{a.uid=uid++;});
  PROFILES.splice(PI+1,0,c); PI++; renderTabs(); renderArsenal(); loadProfile();
};
$('#btnProDel').onclick=()=>{
  if(PROFILES.length<=1) return;
  PROFILES.splice(PI,1); PI=Math.max(0,PI-1);
  renderTabs(); renderArsenal(); loadProfile();
};
$('#btnDelPitch').onclick=()=>{
  const P=PRO(); if(P.arsenal.length<=1) return;
  P.arsenal.splice(P.sel,1); P.sel=Math.max(0,P.sel-1);
  renderTabs(); renderArsenal(); loadProfile();
};
function ioMsg(t){ $('#ioMsg').textContent=t; setTimeout(()=>{$('#ioMsg').textContent='';},3000); }

/* ============================================================
   auto-save to this browser
   Nothing leaves the device. Disabled automatically where the browser
   refuses storage (private windows, sandboxed embeds); the page still
   works, it just will not remember anything between visits.
   ============================================================ */
const LSKEY='pitch-lab-en.v1';
let LSOK=(()=>{ try{ const k='__pl_t'; localStorage.setItem(k,'1'); localStorage.removeItem(k); return true; }
               catch(e){ return false; } })();
let lastSaved=0, saveTimer=null;
function saveTag(){
  const el=$('#saveTag'); if(!el) return;
  if(!LSOK){ el.className='savetag off';
    el.innerHTML='<i></i>Not saving &mdash; this browser blocks storage. Use Export (.json).'; return; }
  el.className='savetag';
  el.innerHTML='<i></i>'+(lastSaved
    ? 'Saved on this device &middot; '+new Date(lastSaved).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})
    : 'Saves on this device automatically');
}
function saveLocal(){
  if(!LSOK) return;
  try{
    saveToProfile();
    localStorage.setItem(LSKEY, JSON.stringify({v:1, t:Date.now(), pi:PI, profiles:PROFILES,
      ui:{batter:S.batter, jitter:TUN.jitter, playSpeed:S.playSpeed}}));
    lastSaved=Date.now();
  }catch(e){ LSOK=false; }
  saveTag();
}
function saveSoon(){ if(!LSOK) return; clearTimeout(saveTimer); saveTimer=setTimeout(saveLocal,700); }
function loadLocal(){
  if(!LSOK) return null;
  try{
    const raw=localStorage.getItem(LSKEY); if(!raw) return null;
    const d=JSON.parse(raw);
    if(!d || d.v!==1 || !Array.isArray(d.profiles) || !d.profiles.length) return null;
    d.profiles=d.profiles.map(normProfile);
    return d;
  }catch(e){ return null; }
}
function clearLocal(){ try{ localStorage.removeItem(LSKEY); }catch(e){} lastSaved=0; saveTag(); }
$('#btnExport').onclick=()=>{
  saveToProfile();
  const data={app:'pitch-lab', version:1, profiles:PROFILES};
  try{
    const blob=new Blob([JSON.stringify(data,null,1)],{type:'application/json'});
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob); a.download='pitch-lab-profiles.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(()=>URL.revokeObjectURL(a.href),2000);
    ioMsg('Exported.');
  }catch(err){ ioMsg('Export failed.'); }
};
$('#btnRoster').onclick=()=>{
  saveToProfile();
  const line='const TEAM_ROSTER = '+JSON.stringify({app:'pitch-lab',version:1,
    profiles:PROFILES.map(p=>({name:p.name,hand:p.hand,note:p.note,
      release:{slot:p.release.slot,height:p.release.height,side:p.release.side,ext:p.release.ext,rub:p.release.rub,
               linkH:p.release.linkH,linkS:p.release.linkS,linkAxis:p.release.linkAxis},
      arsenal:p.arsenal.map(a=>({name:a.name,tilt:a.tilt,rpm:a.rpm,eff:a.eff,velo:a.velo,
        aimX:a.aimX,aimY:a.aimY,tun:a.tun,
        meas:{on:a.meas.on,ivb:a.meas.ivb,hb:a.meas.hb},
        rel:{dh:a.rel.dh,ds:a.rel.ds,de:a.rel.de}}))}))})+';   /* roster built in '+new Date().toISOString().slice(0,10)+' */';
  $('#rosterOut').hidden=false;
  const ta=$('#rosterTxt'); ta.value=line; ta.focus(); ta.select();
  const kb=Math.round(line.length/1024*10)/10;
  $('#rosterMsg').textContent=PROFILES.length+' pitchers, '+kb+' KB.';
  try{ navigator.clipboard.writeText(line).then(
    ()=>{$('#rosterMsg').textContent=PROFILES.length+' pitchers, '+kb+' KB \u2014 copied to the clipboard.';},
    ()=>{$('#rosterMsg').textContent=PROFILES.length+' pitchers, '+kb+' KB \u2014 select the box above and copy.';}); }
  catch(e){ $('#rosterMsg').textContent=PROFILES.length+' pitchers, '+kb+' KB \u2014 select the box above and copy.'; }
  $('#rosterOut').scrollIntoView({behavior:'smooth',block:'nearest'});
};
$('#btnRosterHide').onclick=()=>{ $('#rosterOut').hidden=true; };
let resetArm=0;
$('#btnReset').onclick=e=>{
  const b=e.target;
  if(Date.now()-resetArm>4000){
    resetArm=Date.now(); b.textContent='Really reset?'; b.style.color='var(--bad)';
    setTimeout(()=>{ if(Date.now()-resetArm>=4000){ b.textContent='Reset'; b.style.color=''; } },4100);
    return;
  }
  resetArm=0; b.textContent='Reset'; b.style.color='';
  clearLocal();
  PROFILES=defaultProfiles(); PI=0;
  PROFILES.forEach(p=>p.arsenal.forEach(a=>applyMeas(a,p.hand)));
  renderTabs(); renderArsenal(); renderMeas(); loadProfile();
  ioMsg('Back to the pitchers this page ships with.');
};
$('#btnImport').onclick=()=>$('#fileIn').click();
$('#fileIn').onchange=e=>{
  const f=e.target.files&&e.target.files[0]; if(!f)return;
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      const d=JSON.parse(rd.result);
      const list=Array.isArray(d)?d:(d.profiles||[]);
      if(!list.length) throw 0;
      list.forEach(normProfile);
      PROFILES=PROFILES.concat(list); PI=PROFILES.length-list.length;
      renderTabs(); renderArsenal(); renderMeas(); loadProfile(); saveLocal();
      ioMsg('Loaded '+list.length+' pitcher'+(list.length===1?'':'s')+'.');
    }catch(err){ ioMsg('That file could not be read.'); }
    e.target.value='';
  };
  rd.readAsText(f);
};
$('#bR').onclick=()=>$('#abR').click();
$('#bL').onclick=()=>$('#abL').click();
function setTMode(m){
  TUN.mode=m;
  ['tunnel','own','same'].forEach(k=>$('#tm'+k[0].toUpperCase()+k.slice(1)).setAttribute('aria-pressed',String(k===m)));
  $('#ownAim').hidden = (m!=='own');
  if(m==='own') syncSlotUI();
  updateTunnel();
}
$('#tmTunnel').onclick=()=>setTMode('tunnel');
$('#tmOwn').onclick=()=>setTMode('own');
$('#tmSame').onclick=()=>setTMode('same');
$('#sTAimX').oninput=e=>{S.aimX=-(+e.target.value)/100*S.hand; syncSlotUI(); update();};
$('#sTAimY').oninput=e=>{S.aimY=+e.target.value/100; syncSlotUI(); update();};
$('#btnTFit').onclick=()=>{ fitAim(); syncSlotUI(); };
$('#sJit').oninput=e=>{TUN.jitter=+e.target.value; updateTunnel();};
$('#cTunZoom').onchange=e=>{TUN.zoom=e.target.checked; updateTunnel();};
$('#sScrub').oninput=e=>{TUN.scrub=+e.target.value/100; updateTunnel();};
document.querySelectorAll('[data-jump]').forEach(b=>b.onclick=()=>{
  TUN.scrub=+b.dataset.jump/100; $('#sScrub').value=b.dataset.jump; updateTunnel();});
$('#btnTPlay').onclick=()=>{
  const ta=TUN.anim; ta.prevSim=null;
  if(ta.paused){ ta.paused=false; ta.didPause=true; ta.on=true;
    ta.t0=performance.now()-ta.pt/S.playSpeed*1000; return; }
  ta.on=true; ta.paused=false; ta.didPause=false; ta.t0=performance.now();
};
window.addEventListener('keydown',e=>{if(e.code==='Space'&&e.target.tagName!=='INPUT'){e.preventDefault();play();}});
window.addEventListener('resize',()=>{sizeBall();size3();sizeTun();update();});

/* --- boot --- */
const RESTORED=loadLocal();
if(RESTORED){
  PROFILES=RESTORED.profiles;
  PI=Math.max(0,Math.min(RESTORED.pi|0,PROFILES.length-1));
  if(RESTORED.ui){
    if(RESTORED.ui.batter===1||RESTORED.ui.batter===-1) S.batter=RESTORED.ui.batter;
    if(isFinite(RESTORED.ui.jitter)) TUN.jitter=clamp(RESTORED.ui.jitter,0,10);
    if(isFinite(RESTORED.ui.playSpeed)) S.playSpeed=clamp(RESTORED.ui.playSpeed,0.03,1);
  }
}else{
  PROFILES=defaultProfiles(); PI=0;
  PROFILES.forEach(p=>p.arsenal.forEach(a=>applyMeas(a,p.hand)));
}
refreshTypes(); renderRefTable(); buildAddPitch();
sizeBall(); size3(); sizeTun();
['abR','abL','bR','bL'].forEach(id=>{const el=$('#'+id); if(el)
  el.setAttribute('aria-pressed',String((id==='abR'||id==='bR')===(S.batter===-1)));});
$('#sJit').value=TUN.jitter; $('#oJit').textContent=IN(TUN.jitter/100).toFixed(1)+'"';
$('#sPlaySpd').value=Math.round(S.playSpeed*100);
renderTabs(); renderArsenal(); renderMeas(); loadProfile(); syncSlotUI(); renderCmpTable();
renderScen(); runAnalysis(); amRender();
saveTag();
if(RESTORED) ioMsg('Picked up where you left off ('+PROFILES.length+' pitcher'+(PROFILES.length===1?'':'s')+').');
window.addEventListener('beforeunload',()=>{ clearTimeout(saveTimer); saveLocal(); });
(function loop(t){ drawBall(t); if(anim.on||anim.paused) draw3(); if(TUN.anim.on||TUN.anim.paused) drawTun(); requestAnimationFrame(loop); })(0);
</script>
