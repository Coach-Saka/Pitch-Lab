  // the shared arm direction = the no-spin release angle taken from section 1's aim
  const p0=slotParams(TUN.slots[0]);
  const ref=aimAt(base,MPH(p0.velo),{x:S.aimX,y:S.aimY},{tilt:p0.tilt,rpm:p0.rpm,eff:p0.eff},false);
