function classify(){
  const m=movement(S.velo,S.rpm,S.eff,S.tilt);
  const cur={velo:S.velo, ivb:m.ivb, rpm:S.rpm, effP:S.eff*100, hbArm:armSign(m.hbCatcher)};
  curMv={ivb:m.ivb, hbArm:cur.hbArm, tot:Math.hypot(m.ivb,cur.hbArm)};
  const sc=TYPES.map(t=>{
    let d2=0;
    for(const f of FEAT){ const tv = f.k==='effP'? t.eff*100 : t[f.k];
      d2 += f.w*Math.pow((cur[f.k]-tv)/f.sig,2); }
    return {t,d2,s:Math.exp(-0.5*d2)};
  });
  const sum=sc.reduce((a,b)=>a+b.s,0)||1;
