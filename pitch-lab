function csvNum(v){
  if(v===undefined||v===null) return NaN;
  const t=String(v).replace(/[,%\s]/g,'');
  if(!t) return NaN;
  const x=parseFloat(t);
  return isFinite(x)?x:NaN;
}
function csvParse(text){
  const first=(text.split(/\r?\n/).find(l=>l.trim())||'');
  const d=(first.split('\t').length>first.split(',').length)?'\t':
          (first.split(';').length>first.split(',').length)?';':',';
  const rows=[]; let row=[],cur='',q=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(q){ if(c==='"'){ if(text[i+1]==='"'){cur+='"';i++;} else q=false; } else cur+=c; }
    else if(c==='"') q=true;
    else if(c===d){ row.push(cur); cur=''; }
    else if(c==='\r'){}
    else if(c==='\n'){ row.push(cur); rows.push(row); row=[]; cur=''; }
    else cur+=c;
  }
  if(cur!==''||row.length){ row.push(cur); rows.push(row); }
  return rows;
}
const normH=v=>String(v).toLowerCase().replace(/[_\-\/]/g,' ').replace(/\s+/g,' ').trim();
function headScore(h,f){
  const t=normH(h); if(!t) return 0;
  let best=0;
  f.al.forEach((a,i)=>{
    const w=1-i*0.02;
    if(t===a) best=Math.max(best,100*w);
    else if(t.replace(/\(.*?\)/g,'').trim()===a) best=Math.max(best,92*w);
    else if(t.startsWith(a+' ')||t.startsWith(a+'(')) best=Math.max(best,80*w);
    else if(new RegExp('(^| )'+a.replace(/[.*+?^${}()|\[\]\\]/g,'\\$&')+'( |\\(|$)').test(t)) best=Math.max(best,70*w);
    else if(t.indexOf(a)>=0) best=Math.max(best,52*w);
  });
  if(best&&(f.k==='ivb'||f.k==='hb')){
    if(t.indexOf('trajectory')>=0) best+=14;
    if(t.indexOf('spin')>=0) best-=12;
    if(t.indexOf('%')>=0) best-=30;
  }
  if(best&&f.k==='velo'&&t.indexOf('plate')>=0) best-=25;
  if(best&&f.k==='pname'&&t.indexOf('id')>=0) best-=30;
  return best;
}
function csvAutoMap(head){
  const m={};
