/* --- measured-values table --- */
let measView='c';
function parseClock(v){
  const t=String(v).trim().replace('：',':');
  const m=t.match(/^(\d{1,2})\s*[:.]\s*(\d{1,2})$/);
  let h;
  if(m && t.indexOf(':')>=0) h=+m[1]+(+m[2])/60; else h=parseFloat(t);
  if(!isFinite(h)) return null;
  h=((h%12)+12)%12; if(h<=0.0001) h=12;
  return h;
}
function measStat(a){
  if(!(a.meas&&a.meas.on)) return '<span style="color:var(--text-muted)">computed from spin</span>';
  if(!a.meas.ok) return '<span style="color:var(--bad)">not enough spin<small style="display:block">needs about '+a.meas.need+' rpm</small></span>';
  return '<span style="color:var(--good)">matches the measurement</span>';
}
function renderMeas(){
  const el=$('#measTable'); if(!el) return;
  const P=PRO(); if(!P) return;
  const tv=h=>clockStr(measView==='p'?mirrorClock(h):h);
  const ro=b=>b?' readonly class="mi ro"':' class="mi"';
  let h='<thead><tr><th>Pitch</th><th>Velo<small>mph</small></th><th>Spin<small>rpm</small></th>'+
    '<th>Efficiency<small>%</small></th><th>Axis<small>'+(measView==='p'?'pitcher view':'catcher view')+'</small></th>'+
    '<th>Vert break<small>in</small></th><th>Horz break<small>in, arm +</small></th>'+
    '<th>Measured<small>solve from it</small></th><th>&Delta;Ht<small>in</small></th><th>&Delta;Side<small>in, arm +</small></th>'+
    '<th>&Delta;Ext<small>in</small></th><th>MLB verdict<small>closest type</small></th><th>Status</th></tr></thead><tbody>';
  P.arsenal.forEach((a,i)=>{
    const on=!!(a.meas&&a.meas.on);
    const mv=on?{ivb:a.meas.ivb,hb:a.meas.hb}:calcMove(a,P.hand);
    h+='<tr'+(i===P.sel?' class="cur"':'')+' data-i="'+i+'">'+
      '<td class="nm"><input type="text" data-f="name" class="mi nmi" value="'+esc(a.name)+'"></td>'+
      '<td><input type="number" step="0.1" data-f="velo"'+ro(false)+' value="'+a.velo.toFixed(1)+'"></td>'+
      '<td><input type="number" step="10" data-f="rpm"'+ro(false)+' value="'+Math.round(a.rpm)+'"></td>'+
      '<td><input type="number" step="1" data-f="eff"'+ro(on)+' value="'+Math.round(a.eff*100)+'"></td>'+
      '<td><input type="text" data-f="tilt"'+ro(on)+' value="'+tv(a.tilt)+'"></td>'+
      '<td><input type="number" step="0.1" data-f="ivb"'+ro(!on)+' value="'+mv.ivb.toFixed(1)+'"></td>'+
      '<td><input type="number" step="0.1" data-f="hb"'+ro(!on)+' value="'+mv.hb.toFixed(1)+'"></td>'+
      '<td><input type="checkbox" data-f="on"'+(on?' checked':'')+'></td>'+
      '<td><input type="number" step="0.5" data-f="dh" class="mi" value="'+IN(a.rel.dh).toFixed(1)+'"></td>'+
      '<td><input type="number" step="0.5" data-f="ds" class="mi" value="'+IN(a.rel.ds).toFixed(1)+'"></td>'+
      '<td><input type="number" step="0.5" data-f="de" class="mi" value="'+IN(a.rel.de).toFixed(1)+'"></td>'+
      '<td>'+(()=>{const c=classifyOf(a,P.hand);
        return '<span style="color:var(--text-primary)">'+c.top.short+'</span><small style="display:block;color:var(--text-muted)">'+
               c.pct.toFixed(0)+'%'+(c.pct<55?' ('+c.second.t.short+' '+c.second.pct.toFixed(0)+'%)':'')+'</small>';})()+'</td>'+
      '<td>'+measStat(a)+'</td></tr>';
  });
  el.innerHTML=h+'</tbody>';
  el.querySelectorAll('input').forEach(inp=>{
    const i=+inp.closest('tr').dataset.i, f=inp.dataset.f;
