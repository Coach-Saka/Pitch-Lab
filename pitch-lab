  x3.beginPath(); c.forEach((p,i)=>i?x3.lineTo(p.x,p.y):x3.moveTo(p.x,p.y)); x3.closePath(); x3.stroke();
  x3.strokeStyle='rgba(255,255,255,.10)'; x3.lineWidth=1;
